# OpenCreator Volcengine / Doubao Voice credentials.
# Copy to ~/.opencreator/.env.local, or point OPENCREATOR_ENV_FILE at this file.
# These are the speech console App ID and Access Token, not IAM AK/SK.
# The same Access Token authenticates ASR, TTS V1, and TTS V3.
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_TOKEN=

# Channel Pipeline integration (optional).
# Point this to the local Channel checkout that contains pyproject.toml.
# OPENCREATOR_CHANNEL_REPO takes precedence over CHANNEL_REPO.
OPENCREATOR_CHANNEL_REPO=
