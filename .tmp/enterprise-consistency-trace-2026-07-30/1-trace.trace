: var(--surface-3);\n  color: var(--control-disabled-text);\n  box-shadow:\n    0 8px 18px color-mix(in srgb, var(--shadow-base) 18%, transparent),\n    0 0 0 1px color-mix(in srgb, var(--text) 4%, transparent) inset;\n}\n\n.composer-stop:disabled {\n  border-color: color-mix(in srgb, var(--text) 12%, transparent);\n  background: var(--control-disabled);\n  color: var(--control-disabled-text);\n  box-shadow: none;\n}\n\n.composer-send svg {\n  color: var(--on-accent);\n  stroke-width: 2.35;\n}\n\n.composer-stop svg {\n  stroke-width: 2;\n}\n\n.composer-send:disabled svg {\n  color: var(--control-disabled-text);\n}\n\n.composer-popover {\n  position: absolute;\n  z-index: 30;\n  bottom: calc(100% + 8px);\n  left: 0;\n  min-width: 232px;\n  padding: 6px;\n  border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n  border-radius: 14px;\n  background: color-mix(in srgb, var(--popover) 94%, transparent);\n  box-shadow: 0 24px 60px color-mix(in srgb, var(--shadow-base) 46%, transparent);\n  backdrop-filter: blur(20px);\n}\n\n.composer-right-actions .composer-popover {\n  right: 0;\n  left: auto;\n}\n\n.composer-popover-compact {\n  min-width: 168px;\n}\n\n.composer-menu-item {\n  width: 100%;\n  min-height: 38px;\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr);\n  align-items: center;\n  gap: 8px;\n  padding: 8px 10px;\n  border: 0;\n  border-radius: 10px;\n  background: transparent;\n  color: var(--text);\n  text-align: left;\n}\n\n.composer-menu-item:hover {\n  background: var(--surface-3);\n}\n\n.composer-menu-item.is-active {\n  background: var(--surface-3);\n}\n\n.composer-menu-item > span:last-child {\n  min-width: 0;\n  display: grid;\n  gap: 3px;\n}\n\n.composer-menu-item strong {\n  min-width: 0;\n  overflow: hidden;\n  font-size: 13px;\n  font-weight: 690;\n  line-height: 1.2;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-menu-item small {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.25;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-menu-icon {\n  width: 20px;\n  height: 20px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--text);\n}\n\n.composer-slash-menu {\n  right: 0;\n  bottom: calc(100% + 8px);\n  left: 0;\n  max-height: min(360px, 54vh);\n  overflow: auto;\n}\n\n.composer-slash-group {\n  display: grid;\n  gap: 2px;\n}\n\n.composer-slash-group + .composer-slash-group {\n  margin-top: 6px;\n  padding-top: 6px;\n  border-top: 1px solid var(--border);\n}\n\n.composer-slash-group-label {\n  padding: 4px 10px 5px;\n  color: var(--muted);\n  font: 700 11px/1 var(--font-mono);\n  text-transform: none;\n}\n\n.composer-slash-status {\n  padding: 9px 10px;\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.composer-slash-status-error {\n  color: var(--danger);\n}\n\n.composer-slash-item {\n  grid-template-columns: 24px minmax(0, 1fr);\n}\n\n.composer-queue {\n  position: relative;\n  z-index: 0;\n  max-height: 148px;\n  display: grid;\n  overflow-y: auto;\n  margin: 0 14px -1px;\n  padding: 7px 10px 9px;\n  border: 1px solid var(--border);\n  border-bottom: 0;\n  border-radius: 14px 14px 0 0;\n  background: var(--surface);\n}\n\n.composer-queue-item {\n  min-width: 0;\n  min-height: 30px;\n  display: grid;\n  grid-template-columns: 18px minmax(0, 1fr) auto auto auto;\n  align-items: center;\n  gap: 6px;\n  padding: 2px 2px;\n}\n\n.composer-queue-item + .composer-queue-item {\n  border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n}\n\n.composer-queue-leading {\n  width: 18px;\n  height: 18px;\n  display: inline-grid;\n  place-items: center;\n  color: var(--subtle);\n}\n\n.composer-queue-copy {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--text);\n  font-size: 12px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-queue-position {\n  color: var(--muted);\n  font-size: 11px;\n  white-space: nowrap;\n}\n\n.composer-queue-steer,\n.composer-queue-remove {\n  min-height: 24px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 5px;\n  border: 0;\n  border-radius: 5px;\n  background: transparent;\n  color: var(--muted);\n}\n\n.composer-queue-steer {\n  padding: 0 5px;\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.composer-queue-remove {\n  width: 24px;\n  padding: 0;\n}\n\n.composer-queue-steer:hover,\n.composer-queue-remove:hover {\n  background: var(--surface-3);\n  color: var(--text);\n}\n\n.composer-project-name-backdrop {\n  position: fixed;\n  z-index: 100;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: color-mix(in srgb, var(--shadow-base) 46%, transparent);\n}\n\n.composer-project-name-dialog {\n  width: min(420px, 100%);\n  display: grid;\n  gap: 18px;\n  padding: 20px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface);\n  box-shadow: 0 28px 80px color-mix(in srgb, var(--shadow-base) 52%, transparent);\n}\n\n.composer-project-name-dialog header,\n.composer-project-name-dialog label {\n  display: grid;\n  gap: 6px;\n}\n\n.composer-project-name-dialog header strong {\n  font-size: 17px;\n}\n\n.composer-project-name-dialog header span,\n.composer-project-name-dialog label span {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.composer-project-name-dialog input {\n  width: 100%;\n  height: 38px;\n  padding: 0 10px;\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  background: var(--surface-2);\n  color: var(--text);\n  font-size: 14px;\n}\n\n.composer-project-name-dialog footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.clawee-sidebar-pane,\n.clawee-main-pane,\n.clawee-detail-pane {\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.clawee-sidebar-pane {\n  background: var(--sidebar);\n  border-right: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n}\n\n.clawee-main-pane {\n  display: grid;\n  grid-template-rows: minmax(0, 1fr);\n  background: var(--conversation-bg);\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.clawee-main-content {\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.mobile-navigation-toolbar,\n.mobile-navigation-backdrop,\n.mobile-navigation-close {\n  display: none;\n}\n\n.clawee-detail-pane {\n  background: var(--surface);\n  border-left: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n}\n\n.clawee-sidebar {\n  height: 100%;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: auto auto minmax(0, 1fr) auto auto;\n  gap: 18px;\n  padding: 24px 12px 12px;\n  color: var(--text);\n}\n\n.sidebar-brand {\n  min-width: 0;\n  min-height: 50px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 0 8px 0 6px;\n}\n\n.sidebar-logo-lockup {\n  min-width: 0;\n  height: 50px;\n  display: flex;\n  align-items: center;\n}\n\n.sidebar-logo-image {\n  display: block;\n  object-fit: contain;\n}\n\n.sidebar-logo-full {\n  width: 124px;\n  height: 50px;\n  object-position: left center;\n  transform: translateX(-11px);\n}\n\n.sidebar-logo-mark {\n  width: 38px;\n  height: 38px;\n}\n\n.sidebar-collapse-button,\n.sidebar-brand-button {\n  width: 38px;\n  height: 38px;\n  flex: 0 0 auto;\n  display: grid;\n  place-items: center;\n  padding: 0;\n  border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n  border-radius: 10px;\n  color: color-mix(in srgb, var(--text) 68%, transparent);\n  background: color-mix(in srgb, var(--text) 3.5%, transparent);\n}\n\n.sidebar-collapse-button:hover,\n.sidebar-brand-button:hover {\n  border-color: color-mix(in srgb, var(--text) 14%, transparent);\n  background: color-mix(in srgb, var(--text) 8%, transparent);\n  color: var(--text);\n}\n\n.sidebar-brand-button {\n  position: relative;\n  overflow: hidden;\n  border-color: #1f1f1f;\n  color: #fff;\n  background: #1f1f1f;\n}\n\n.sidebar-brand-button:hover,\n.sidebar-brand-button:focus-visible {\n  border-color: #2c2c2c;\n  color: #fff;\n  background: #2c2c2c;\n}\n\n.sidebar-brand-button .sidebar-logo-image,\n.sidebar-expand-icon {\n  transition:\n    opacity 180ms ease,\n    transform 180ms ease;\n}\n\n.sidebar-expand-icon {\n  position: absolute;\n  opacity: 0;\n  transform: scale(0.84);\n}\n\n.sidebar-brand-button:hover .sidebar-logo-image,\n.sidebar-brand-button:focus-visible .sidebar-logo-image {\n  opacity: 0;\n  transform: scale(0.84);\n}\n\n.sidebar-brand-button:hover .sidebar-expand-icon,\n.sidebar-brand-button:focus-visible .sidebar-expand-icon {\n  opacity: 1;\n  transform: scale(1);\n}\n\n.sidebar-primary,\n.sidebar-section-list,\n.sidebar-project-tree,\n.sidebar-project-node,\n.sidebar-conversation-tree {\n  display: grid;\n  gap: 3px;\n}\n\n.sidebar-section {\n  min-width: 0;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  gap: 8px;\n}\n\n.sidebar-task-section {\n  min-height: 0;\n  max-height: 220px;\n}\n\n.sidebar-task-list {\n  min-height: 0;\n  display: grid;\n  grid-auto-rows: 44px;\n  align-content: start;\n  gap: 3px;\n  overflow-x: hidden;\n  overflow-y: auto;\n  margin-right: -12px;\n  padding-right: 12px;\n}\n\n.sidebar-task-row-shell {\n  min-width: 0;\n  height: 44px;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 28px;\n  align-items: center;\n  gap: 2px;\n}\n\n.sidebar-task-row {\n  width: 100%;\n  min-width: 0;\n  height: 44px;\n  min-height: 44px;\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr) 8px;\n  align-items: center;\n  gap: 6px;\n  padding: 0 8px;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  color: inherit;\n  text-align: left;\n}\n\n.sidebar-task-delete {\n  width: 28px;\n  height: 28px;\n  display: inline-grid;\n  place-items: center;\n  border: 1px solid transparent;\n  border-radius: 7px;\n  color: var(--subtle);\n}\n\n.sidebar-task-delete:hover {\n  border-color: color-mix(in srgb, var(--danger) 28%, var(--border));\n  background: color-mix(in srgb, var(--danger) 9%, transparent);\n  color: var(--danger);\n}\n\n.sidebar-task-delete:disabled {\n  cursor: wait;\n  opacity: 0.7;\n}\n\n.sidebar-task-row:hover {\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n}\n\n.sidebar-task-row[aria-current=\"page\"] {\n  border-color: color-mix(in srgb, var(--accent) 22%, var(--border));\n  background: var(--accent-soft);\n}\n\n.sidebar-task-row:disabled {\n  cursor: not-allowed;\n  opacity: 0.72;\n}\n\n.sidebar-task-row:disabled:hover {\n  background: transparent;\n}\n\n.sidebar-task-copy {\n  min-width: 0;\n  display: grid;\n  gap: 1px;\n}\n\n.sidebar-task-copy strong,\n.sidebar-task-copy span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.sidebar-task-copy strong {\n  color: var(--text);\n  font-size: 13px;\n  font-weight: 680;\n}\n\n.sidebar-task-copy span {\n  color: var(--subtle);\n  font-size: 11px;\n  line-height: 14px;\n}\n\n.sidebar-task-icon {\n  color: color-mix(in srgb, var(--text) 62%, transparent);\n}\n\n.sidebar-task-row[data-status=\"draft\"] .sidebar-task-icon {\n  color: var(--accent);\n}\n\n.sidebar-task-row[data-status=\"waiting_approval\"] .sidebar-task-icon {\n  color: var(--warning);\n}\n\n.sidebar-task-row[data-status=\"failed\"] .sidebar-task-icon,\n.sidebar-task-row[data-status=\"repair_required\"] .sidebar-task-icon {\n  color: var(--danger);\n}\n\n.sidebar-task-row[data-status=\"paused\"] .sidebar-task-icon {\n  color: var(--subtle);\n}\n\n.sidebar-task-spinner {\n  color: var(--accent);\n  animation: conversation-run-spin 900ms linear infinite;\n}\n\n.sidebar-task-unread {\n  width: 7px;\n  height: 7px;\n  border-radius: 999px;\n  background: var(--warning);\n  box-shadow: 0 0 10px var(--warning-soft);\n}\n\n.sidebar-section h2 {\n  margin: 0;\n  padding: 0 16px;\n  color: var(--subtle);\n  font-size: 13px;\n  font-weight: 700;\n  line-height: 22px;\n}\n\n.sidebar-section-heading {\n  min-width: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 58px;\n  align-items: center;\n  gap: 2px;\n  padding-right: 0;\n}\n\n.sidebar-section-actions {\n  width: 58px;\n  display: grid;\n  grid-template-columns: repeat(2, 28px);\n  align-items: center;\n  gap: 2px;\n}\n\n.sidebar-section-action,\n.sidebar-project-menu-trigger {\n  width: 28px;\n  height: 28px;\n  flex: 0 0 auto;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid transparent;\n  border-radius: 7px;\n  color: var(--subtle);\n}\n\n.sidebar-section-action:hover,\n.sidebar-project-menu-trigger:hover,\n.sidebar-project-menu-trigger[aria-expanded=\"true\"] {\n  border-color: color-mix(in srgb, var(--text) 10%, transparent);\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n  color: var(--text);\n}\n\n.sidebar-project-tree {\n  min-height: 0;\n  align-content: start;\n  grid-auto-rows: max-content;\n  overflow-x: hidden;\n  overflow-y: auto;\n  margin-right: -12px;\n  padding: 0 12px 4px 0;\n}\n\n.sidebar-conversation-tree {\n  padding: 2px 0 7px;\n}\n\n.sidebar-conversation-row-shell {\n  min-width: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  align-items: center;\n}\n\n.sidebar-conversation-row-shell[data-has-action=\"true\"] {\n  grid-template-columns: minmax(0, 1fr) 28px;\n}\n\n.sidebar-conversation-archive {\n  width: 28px;\n  height: 28px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid transparent;\n  border-radius: 7px;\n  color: var(--subtle);\n  opacity: 0;\n  transition: opacity 120ms ease;\n}\n\n.sidebar-conversation-row-shell:hover .sidebar-conversation-archive,\n.sidebar-conversation-row-shell:focus-within .sidebar-conversation-archive,\n.nested-conversation-row[aria-current=\"page\"] + .sidebar-conversation-archive {\n  opacity: 1;\n}\n\n.sidebar-conversation-archive:hover:not(:disabled) {\n  border-color: color-mix(in srgb, var(--text) 10%, transparent);\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n  color: var(--text);\n}\n\n.sidebar-conversation-archive:disabled {\n  cursor: not-allowed;\n  color: color-mix(in srgb, var(--subtle) 58%, transparent);\n}\n\n@media (hover: none) {\n  .sidebar-conversation-archive {\n    opacity: 1;\n  }\n}\n\n.sidebar-project-row-shell {\n  position: relative;\n  min-width: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 58px;\n  align-items: center;\n  gap: 2px;\n}\n\n.sidebar-project-actions {\n  position: relative;\n  width: 58px;\n  display: grid;\n  grid-template-columns: repeat(2, 28px);\n  align-items: center;\n  gap: 2px;\n  opacity: 0;\n  transition: opacity 120ms ease;\n}\n\n.sidebar-project-row-shell:hover .sidebar-project-actions,\n.sidebar-project-row-shell:focus-within .sidebar-project-actions {\n  opacity: 1;\n}\n\n.sidebar-project-new-conversation,\n.sidebar-project-menu-trigger {\n  width: 28px;\n  height: 28px;\n  flex: 0 0 auto;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid transparent;\n  border-radius: 7px;\n  color: var(--subtle);\n}\n\n.sidebar-project-new-conversation:hover {\n  border-color: color-mix(in srgb, var(--text) 10%, transparent);\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n  color: var(--text);\n}\n\n.sidebar-project-menu-shell {\n  position: relative;\n}\n\n.sidebar-project-menu {\n  position: absolute;\n  z-index: 20;\n  top: calc(100% + 4px);\n  right: 0;\n  width: 156px;\n  padding: 4px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--popover);\n  box-shadow: 0 14px 32px color-mix(in srgb, var(--shadow-base) 26%, transparent);\n}\n\n.sidebar-project-menu button {\n  width: 100%;\n  min-height: 34px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 0 9px;\n  border-radius: 6px;\n  color: var(--text);\n  text-align: left;\n}\n\n.sidebar-project-menu button:hover {\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n}\n\n.sidebar-row,\n.conversation-row {\n  width: 100%;\n  min-width: 0;\n  border: 1px solid transparent;\n  border-radius: 9px;\n  color: inherit;\n  text-align: left;\n}\n\n.sidebar-row {\n  height: 40px;\n  min-height: 40px;\n  display: grid;\n  grid-template-columns: 22px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 4px;\n  padding: 0 6px;\n  font-size: 14px;\n  font-weight: 680;\n}\n\n.project-row {\n  font-weight: 520;\n}\n\n.project-row[data-current-project=\"true\"] .project-icon {\n  color: var(--accent);\n  filter: drop-shadow(0 0 10px var(--accent-glow));\n}\n\n.sidebar-row:hover,\n.conversation-row:hover,\n.sidebar-account-button:hover,\n.sidebar-settings-button:hover {\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n}\n\n.sidebar-row[aria-current=\"true\"],\n.sidebar-row[aria-current=\"page\"] {\n  border-color: color-mix(in srgb, var(--accent) 22%, var(--border));\n  background: var(--accent-soft);\n  box-shadow: 0 0 22px var(--accent-soft);\n}\n\n.sidebar-row svg {\n  color: color-mix(in srgb, var(--text) 72%, transparent);\n}\n\n.sidebar-row span,\n.conversation-row strong,\n.conversation-row span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.conversation-row {\n  min-height: 32px;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 10px;\n  padding: 0 10px 0 32px;\n}\n\n.nested-conversation-row[aria-current=\"page\"] {\n  background: var(--accent-soft);\n}\n\n.conversation-row strong {\n  font-size: 13.5px;\n  font-weight: 700;\n}\n\n.conversation-row-meta {\n  display: inline-flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 6px;\n}\n\n.conversation-run-spinner {\n  flex: 0 0 auto;\n  color: var(--accent);\n  animation: conversation-run-spin 900ms linear infinite;\n}\n\n.conversation-row span,\n.sidebar-empty {\n  color: var(--subtle);\n  font-size: 12px;\n}\n\n@keyframes conversation-run-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .conversation-run-spinner {\n    animation: none;\n  }\n\n  .process-summary-spinner {\n    animation: none;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .sidebar-task-spinner {\n    animation: none;\n  }\n}\n\n.sidebar-empty {\n  margin: 0;\n  padding: 4px 16px;\n  font-weight: 650;\n}\n\n.sidebar-bottom {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 36px;\n  align-items: center;\n  gap: 4px;\n  padding-top: 8px;\n  border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n}\n\n.sidebar-account-button {\n  min-width: 0;\n  height: 42px;\n  display: grid;\n  grid-template-columns: 26px minmax(0, 1fr);\n  align-items: center;\n  gap: 7px;\n  padding: 0 6px;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  color: inherit;\n  text-align: left;\n}\n\n.sidebar-account-button[aria-current=\"page\"],\n.sidebar-settings-button[aria-current=\"page\"] {\n  border-color: color-mix(in srgb, var(--accent) 22%, var(--border));\n  background: var(--accent-soft);\n}\n\n.sidebar-account-avatar {\n  width: 26px;\n  height: 26px;\n  flex: 0 0 auto;\n  display: grid;\n  place-items: center;\n  border: 1px solid color-mix(in srgb, var(--text) 9%, transparent);\n  border-radius: 8px;\n  background: var(--surface-3);\n  color: var(--text);\n}\n\n.sidebar-account-copy {\n  min-width: 0;\n  display: grid;\n  gap: 1px;\n}\n\n.sidebar-account-copy strong,\n.sidebar-account-copy small {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.sidebar-account-copy strong {\n  font-size: 13px;\n  font-weight: 680;\n}\n\n.sidebar-account-copy small {\n  color: var(--subtle);\n  font-size: 10px;\n}\n\n.sidebar-settings-button {\n  width: 36px;\n  height: 36px;\n  display: grid;\n  place-items: center;\n  padding: 0;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  color: color-mix(in srgb, var(--text) 72%, transparent);\n}\n\n.clawee-sidebar-pane[data-collapsed=\"true\"] {\n  background: var(--sidebar);\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] {\n  grid-template-rows: auto auto minmax(0, 1fr) auto;\n  gap: 14px;\n  align-items: start;\n  padding: 20px 8px 12px;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-brand {\n  justify-content: center;\n  padding: 0;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-primary {\n  justify-items: center;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-row {\n  width: 44px;\n  height: 42px;\n  min-height: 42px;\n  grid-template-columns: 1fr;\n  justify-items: center;\n  gap: 0;\n  padding: 0;\n  border-radius: 12px;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-row > span {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-bottom {\n  grid-row: 4;\n  grid-template-columns: 1fr;\n  justify-items: center;\n  gap: 4px;\n  padding-top: 0;\n  border-top: 0;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-account-button,\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-settings-button {\n  width: 44px;\n  height: 42px;\n  display: grid;\n  place-items: center;\n  grid-template-columns: 1fr;\n  padding: 0;\n  border-radius: 12px;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-account-copy {\n  display: none;\n}\n\n.enterprise-account-page {\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  overflow: auto;\n  padding: 32px clamp(24px, 5vw, 64px) 56px;\n  background: var(--conversation-bg);\n  color: var(--text);\n}\n\n.enterprise-account-status,\n.enterprise-account-error,\n.enterprise-account-notice,\n.enterprise-account-panel {\n  width: min(720px, 100%);\n  margin-right: auto;\n  margin-left: auto;\n}\n\n.enterprise-account-status {\n  display: grid;\n  grid-template-columns: 22px minmax(0, 1fr);\n  align-items: start;\n  gap: 10px;\n  margin-top: 18px;\n  padding: 12px 14px;\n  border: 1px solid color-mix(in srgb, var(--warning) 35%, var(--border));\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--warning) 8%, var(--surface));\n  color: var(--warning);\n}\n\n.enterprise-account-status {\n  margin-top: 0;\n  border-color: var(--border);\n  background: var(--surface-2);\n  color: var(--muted);\n}\n\n.enterprise-account-status strong,\n.enterprise-account-status span {\n  display: block;\n}\n\n.enterprise-account-status strong {\n  color: var(--text);\n  font-size: 12px;\n}\n\n.enterprise-account-status span {\n  margin-top: 3px;\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.5;\n}\n\n.enterprise-account-error,\n.enterprise-account-notice {\n  margin-top: 16px;\n  margin-bottom: 0;\n  padding: 10px 12px;\n  border: 1px solid color-mix(in srgb, var(--danger) 32%, var(--border));\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--danger) 8%, var(--surface));\n  color: var(--danger);\n  font-size: 12px;\n}\n\n.enterprise-account-notice {\n  border-color: color-mix(in srgb, var(--success) 32%, var(--border));\n  background: color-mix(in srgb, var(--success) 7%, var(--surface));\n  color: var(--success);\n}\n\n.enterprise-account-panel {\n  margin-top: 22px;\n  padding: 24px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface);\n  box-shadow: 0 16px 38px color-mix(in srgb, var(--shadow-base) 18%, transparent);\n}\n\n.enterprise-account-session-panel,\n.enterprise-account-profile {\n  display: grid;\n  grid-template-columns: 36px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 16px;\n}\n\n.enterprise-account-session-panel h2,\n.enterprise-account-profile h2,\n.enterprise-account-form-heading h2 {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 710;\n}\n\n.enterprise-account-session-panel p,\n.enterprise-account-profile p,\n.enterprise-account-form-heading p {\n  margin: 5px 0 0;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.55;\n}\n\n.enterprise-account-session-panel p strong,\n.enterprise-account-session-panel p span {\n  margin-left: 6px;\n}\n\n.enterprise-account-spinner {\n  animation: conversation-run-spin 900ms linear infinite;\n}\n\n.enterprise-account-secondary-action,\n.enterprise-account-primary-action {\n  min-height: 36px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  padding: 0 13px;\n  border: 1px solid var(--border-strong);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--text);\n  font-size: 12px;\n  font-weight: 680;\n}\n\n.enterprise-account-secondary-action:hover:not(:disabled) {\n  border-color: color-mix(in srgb, var(--accent) 35%, var(--border-strong));\n  background: var(--surface-3);\n}\n\n.enterprise-account-secondary-action:disabled,\n.enterprise-account-primary-action:disabled {\n  cursor: not-allowed;\n  opacity: 0.58;\n}\n\n.enterprise-account-profile-icon,\n.enterprise-account-form-icon {\n  width: 36px;\n  height: 36px;\n  display: grid;\n  place-items: center;\n  border: 1px solid color-mix(in srgb, var(--success) 28%, var(--border));\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--success) 8%, var(--surface-2));\n  color: var(--success);\n}\n\n.enterprise-account-profile-copy {\n  min-width: 0;\n}\n\n.enterprise-account-profile-copy > span {\n  color: var(--success);\n  font-size: 11px;\n  font-weight: 680;\n}\n\n.enterprise-account-profile-copy small {\n  display: block;\n  margin-top: 9px;\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n.enterprise-account-form-panel {\n  max-width: 520px;\n  margin-top: 0;\n}\n\n.enterprise-account-form-heading {\n  display: grid;\n  grid-template-columns: 36px minmax(0, 1fr);\n  align-items: center;\n  gap: 12px;\n}\n\n.enterprise-account-form-icon {\n  border-color: color-mix(in srgb, var(--accent) 28%, var(--border));\n  background: var(--accent-soft);\n  color: var(--accent);\n}\n\n.enterprise-account-segmented {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 3px;\n  margin-top: 22px;\n  padding: 3px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface-2);\n}\n\n.enterprise-account-segmented button {\n  min-height: 34px;\n  border-radius: 6px;\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 680;\n}\n\n.enterprise-account-segmented button[aria-pressed=\"true\"] {\n  background: var(--surface);\n  color: var(--text);\n  box-shadow: inset 0 0 0 1px var(--border-strong);\n}\n\n.enterprise-account-form {\n  display: grid;\n  gap: 14px;\n  margin-top: 20px;\n}\n\n.enterprise-account-form label {\n  display: grid;\n  gap: 7px;\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 650;\n}\n\n.enterprise-account-form input {\n  width: 100%;\n  height: 40px;\n  padding: 0 11px;\n  border: 1px solid var(--border-strong);\n  border-radius: 7px;\n  outline: 0;\n  background: var(--input-bg);\n  color: var(--text);\n}\n\n.enterprise-account-form input:focus {\n  border-color: color-mix(in srgb, var(--accent) 66%, var(--border-strong));\n  box-shadow: 0 0 0 3px var(--accent-soft);\n}\n\n.enterprise-account-primary-action {\n  margin-top: 4px;\n  border-color: var(--accent);\n  background: var(--accent);\n  color: var(--on-accent);\n}\n\n.enterprise-account-primary-action:hover:not(:disabled) {\n  filter: brightness(1.06);\n}\n\n@media (max-width: 720px) {\n  .enterprise-account-page {\n    padding: 24px 16px 40px;\n  }\n\n  .enterprise-account-session-panel,\n  .enterprise-account-profile {\n    grid-template-columns: 36px minmax(0, 1fr);\n  }\n\n  .enterprise-account-session-panel .enterprise-account-secondary-action,\n  .enterprise-account-profile .enterprise-account-secondary-action {\n    grid-column: 1 / -1;\n    width: 100%;\n  }\n}\n\n.detail-panel {\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  border-left: 1px solid var(--border);\n  background: var(--surface);\n  color: var(--text);\n}\n\n.settings-page {\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  display: grid;\n  grid-template-columns: 240px minmax(0, 1fr);\n  background: var(--bg);\n  color: var(--text);\n}\n\n.settings-sidebar {\n  min-width: 0;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: auto auto auto minmax(0, 1fr);\n  gap: 14px;\n  padding: 14px 12px;\n  border-right: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n  background: var(--sidebar);\n}\n\n.settings-back {\n  min-height: 32px;\n  justify-self: start;\n  padding: 0 10px;\n  border-radius: 7px;\n  background: color-mix(in srgb, var(--text) 6%, transparent);\n  color: var(--text);\n  font-size: 13px;\n  font-weight: 650;\n}\n\n.settings-back:hover,\n.settings-nav button:hover,\n.settings-action:hover {\n  background: color-mix(in srgb, var(--text) 10%, transparent);\n}\n\n.settings-search {\n  min-width: 0;\n  display: grid;\n  gap: 6px;\n}\n\n.settings-search span {\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 650;\n}\n\n.settings-search input {\n  width: 100%;\n  min-width: 0;\n  height: 34px;\n  padding: 0 10px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface-2);\n  color: var(--text);\n  font-size: 13px;\n}\n\n.settings-nav {\n  min-width: 0;\n  display: grid;\n  align-content: start;\n  gap: 4px;\n}\n\n.settings-nav button {\n  width: 100%;\n  min-height: 34px;\n  padding: 0 10px;\n  border-radius: 7px;\n  color: var(--text);\n  text-align: left;\n  font-size: 13px;\n  font-weight: 650;\n}\n\n.settings-nav button[aria-current=\"page\"] {\n  background: var(--accent-soft);\n  box-shadow: inset 2px 0 0 var(--accent);\n}\n\n.settings-content {\n  min-width: 0;\n  min-height: 0;\n  overflow: auto;\n  padding: 48px clamp(24px, 6vw, 72px);\n}\n\n.settings-section {\n  width: min(720px, 100%);\n  display: grid;\n  gap: 18px;\n}\n\n.settings-section header {\n  display: grid;\n  gap: 6px;\n}\n\n.settings-section h1,\n.settings-section h2,\n.settings-section p {\n  margin: 0;\n}\n\n.settings-section h1 {\n  font-size: 26px;\n  line-height: 1.2;\n}\n\n.settings-section h2 {\n  padding: 4px 14px 0;\n  font-size: 13px;\n  line-height: 1.4;\n}\n\n.settings-section p {\n  color: var(--muted);\n  font-size: 13px;\n  line-height: 1.5;\n}\n\n.settings-card {\n  min-width: 0;\n  display: grid;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: var(--surface);\n  box-shadow: var(--shadow);\n}\n\n.settings-row {\n  min-width: 0;\n  min-height: 48px;\n  display: grid;\n  grid-template-columns: minmax(160px, 0.8fr) minmax(0, 1.2fr);\n  align-items: center;\n  gap: 16px;\n  padding: 10px 14px;\n  border-top: 1px solid var(--border);\n}\n\n.settings-row:first-child {\n  border-top: 0;\n}\n\n.settings-row span {\n  color: var(--muted);\n  font-size: 13px;\n  font-weight: 650;\n}\n\n.settings-row strong {\n  min-width: 0;\n  color: var(--text);\n  font-size: 13px;\n  font-weight: 520;\n  overflow-wrap: anywhere;\n  text-align: right;\n}\n\n.settings-control-row {\n  grid-template-columns: minmax(160px, 1fr) auto;\n}\n\n.settings-select {\n  width: min(240px, 100%);\n  min-width: 180px;\n  height: 34px;\n  justify-self: end;\n  padding: 0 34px 0 10px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--text);\n}\n\n.settings-color-mode {\n  justify-self: end;\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n  padding: 3px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n}\n\n.settings-color-mode button {\n  min-width: 68px;\n  height: 28px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  padding: 0 9px;\n  border-radius: 5px;\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 650;\n  white-space: nowrap;\n}\n\n.settings-color-mode button:hover {\n  color: var(--text);\n}\n\n.settings-color-mode button[aria-pressed=\"true\"] {\n  background: var(--text);\n  color: var(--bg);\n  box-shadow: none;\n}\n\n.settings-accent-color {\n  display: flex;\n  align-items: start;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.settings-accent-controls {\n  justify-self: end;\n  min-width: 0;\n}\n\n.settings-accent-options {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 4px;\n}\n\n.settings-accent-options > button {\n  width: 30px;\n  height: 30px;\n  display: inline-grid;\n  place-items: center;\n  padding: 0;\n  border: 1px solid transparent;\n  border-radius: 7px;\n  color: rgba(255, 255, 255, 0.94);\n}\n\n.settings-accent-options > button:hover {\n  background: color-mix(in srgb, var(--settings-accent-swatch) 9%, transparent);\n}\n\n.settings-accent-options > button[aria-checked=\"true\"] {\n  border-color: color-mix(in srgb, var(--settings-accent-swatch) 62%, var(--border));\n  background: color-mix(in srgb, var(--settings-accent-swatch) 13%, transparent);\n}\n\n.settings-custom-accent-option {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n}\n\n.settings-row .settings-accent-separator {\n  color: var(--subtle);\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 30px;\n}\n\n.settings-custom-accent-option > .settings-custom-accent-choice {\n  width: auto;\n  display: inline-flex;\n  flex-direction: row;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 6px;\n  padding: 0 2px;\n  border-color: transparent;\n  background: transparent;\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 600;\n  white-space: nowrap;\n}\n\n.settings-custom-accent-option > .settings-custom-accent-choice:hover,\n.settings-custom-accent-option > .settings-custom-accent-choice[aria-checked=\"true\"] {\n  border-color: transparent;\n  background: transparent;\n  color: var(--text);\n}\n\n.settings-accent-swatch {\n  width: 18px;\n  height: 18px;\n  display: grid;\n  place-items: center;\n  border-radius: 999px;\n  background: var(--settings-accent-swatch);\n  color: inherit !important;\n}\n\n.settings-custom-accent-choice .settings-accent-swatch {\n  color: var(--custom-on-accent) !important;\n}\n\n.settings-custom-accent {\n  position: relative;\n  width: 128px;\n  display: grid;\n  gap: 3px;\n}\n\n.settings-custom-accent-input-label {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n.settings-custom-accent input {\n  width: 100%;\n  height: 30px;\n  padding: 0 9px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  outline: none;\n  background: var(--surface-2);\n  color: var(--text);\n  box-shadow: none;\n  font-family: var(--font-mono);\n  font-size: 12px;\n}\n\n.settings-custom-accent input:focus-visible {\n  border-color: var(--border-strong);\n  outline: none;\n  box-shadow: none;\n}\n\n.settings-custom-accent input[aria-invalid=\"true\"] {\n  border-color: color-mix(in srgb, var(--danger) 58%, var(--border));\n}\n\n.settings-custom-accent .settings-custom-accent-error {\n  margin: 0;\n  color: var(--danger);\n  font-size: 11px;\n  line-height: 1.35;\n}\n\n.settings-action {\n  justify-self: end;\n  min-height: 30px;\n  padding: 0 10px;\n  border-radius: 7px;\n  background: color-mix(in srgb, var(--text) 6%, transparent);\n  color: var(--text);\n  font-size: 13px;\n  font-weight: 650;\n}\n\n.settings-advanced {\n  gap: 0;\n}\n\n@media (max-width: 720px) {\n  .settings-page {\n    height: 100%;\n    min-height: 0;\n    grid-template-columns: 1fr;\n    grid-template-rows: auto minmax(0, 1fr);\n  }\n\n  .settings-sidebar {\n    grid-template-rows: auto auto auto;\n    border-right: 0;\n    border-bottom: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n  }\n\n  .settings-nav {\n    display: flex;\n    gap: 4px;\n    padding-bottom: 2px;\n    overflow-x: auto;\n    overscroll-behavior-x: contain;\n  }\n\n  .settings-nav button {\n    width: auto;\n    flex: 0 0 auto;\n    white-space: nowrap;\n  }\n\n  .settings-content {\n    min-height: 0;\n    overflow: auto;\n    padding: 24px 16px;\n  }\n\n  .settings-row {\n    grid-template-columns: 1fr;\n    gap: 4px;\n  }\n\n  .settings-row strong {\n    text-align: left;\n  }\n\n  .settings-select {\n    width: 100%;\n    min-width: 0;\n    justify-self: stretch;\n  }\n\n  .settings-accent-controls {\n    justify-self: stretch;\n  }\n\n  .settings-accent-color {\n    justify-content: flex-start;\n  }\n\n  .settings-custom-accent {\n    width: min(196px, 100%);\n  }\n\n  .settings-action {\n    justify-self: start;\n  }\n}\n\n.detail-header {\n  min-width: 0;\n  min-height: 56px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 10px 14px;\n  border-bottom: 1px solid var(--border);\n  background: var(--surface);\n}\n\n.detail-title {\n  min-width: 0;\n  display: grid;\n  gap: 2px;\n}\n\n.detail-title h2 {\n  margin: 0;\n  overflow: hidden;\n  color: var(--text);\n  font-size: 14px;\n  font-weight: 720;\n  line-height: 1.25;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.detail-title span {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.3;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.detail-content {\n  min-width: 0;\n  min-height: 0;\n  overflow: auto;\n  padding: 14px;\n  background: var(--surface-2);\n}\n\n.detail-content pre {\n  min-height: 100%;\n  margin: 0;\n  padding: 12px;\n  overflow: auto;\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  background: var(--surface);\n  color: var(--text);\n  font: 12px/1.55 var(--font-mono);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.detail-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 12px 14px;\n  border-top: 1px solid var(--border);\n  background: var(--surface);\n}\n\n@media (max-height: 560px) and (min-width: 921px) {\n  .composer-wrap {\n    padding: 0 clamp(18px, 4vw, 52px) 10px;\n  }\n}\n\n.toolbar-button.primary {\n  border-color: color-mix(in srgb, var(--accent) 72%, var(--border));\n  background: linear-gradient(180deg, var(--accent-strong), var(--accent));\n  color: var(--on-accent);\n  box-shadow: 0 10px 24px var(--accent-glow);\n}\n\n.toolbar-button.primary:hover {\n  background: var(--accent-strong);\n}\n\n.toolbar-button:disabled,\n.icon-button:disabled,\n.toolbar-button.primary:disabled {\n  border-color: var(--border);\n  background: var(--surface-3);\n  color: var(--subtle);\n}\n\n@media (max-width: 920px) {\n  .clawee-shell,\n  .clawee-shell.has-detail {\n    width: 100%;\n    height: 100dvh;\n    min-height: 0;\n    grid-template-columns: 1fr;\n    grid-template-rows: minmax(0, 1fr);\n    overflow: hidden;\n  }\n\n  .clawee-main-pane {\n    height: 100dvh;\n    grid-template-rows: auto minmax(0, 1fr);\n    overflow: hidden;\n  }\n\n  .clawee-sidebar-pane {\n    position: fixed;\n    inset: 0 auto 0 0;\n    z-index: 72;\n    width: min(320px, calc(100vw - 48px));\n    border-right: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n    border-bottom: 0;\n    box-shadow: 18px 0 44px color-mix(in srgb, var(--shadow-base) 38%, transparent);\n    transform: translateX(-100%);\n    visibility: hidden;\n    transition:\n      transform 180ms ease,\n      visibility 180ms ease;\n  }\n\n  .clawee-sidebar-pane[data-mobile-open=\"true\"] {\n    transform: translateX(0);\n    visibility: visible;\n  }\n\n  .clawee-sidebar {\n    height: 100%;\n    padding-top: 18px;\n  }\n\n  .sidebar-collapse-button {\n    display: none;\n  }\n\n  .mobile-navigation-toolbar {\n    min-width: 0;\n    min-height: 50px;\n    display: flex;\n    align-items: center;\n    padding: 6px 10px;\n    border-bottom: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n    background: var(--conversation-bg);\n  }\n\n  .mobile-navigation-trigger,\n  .mobile-navigation-close {\n    width: 38px;\n    height: 38px;\n    place-items: center;\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    background: var(--surface-2);\n    color: var(--text);\n  }\n\n  .mobile-navigation-trigger {\n    display: inline-grid;\n  }\n\n  .mobile-navigation-close {\n    position: absolute;\n    top: 18px;\n    right: 12px;\n    z-index: 1;\n    display: grid;\n  }\n\n  .mobile-navigation-backdrop {\n    position: fixed;\n    inset: 0;\n    z-index: 71;\n    display: block;\n    width: 100%;\n    height: 100%;\n    padding: 0;\n    border: 0;\n    border-radius: 0;\n    background: color-mix(in srgb, var(--shadow-base) 66%, transparent);\n  }\n\n  .clawee-main-content {\n    min-height: 0;\n    overflow: auto;\n    overscroll-behavior: contain;\n  }\n\n  .sidebar-bottom {\n    padding-top: 4px;\n  }\n\n  .clawee-detail-pane {\n    display: none;\n  }\n\n  .conversation-file-layout {\n    grid-template-columns: 1fr;\n    grid-template-rows: minmax(520px, 1fr) minmax(520px, 1fr);\n  }\n\n  .conversation-file-layout > .conversation-page {\n    border-right: 0;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .conversation-file-resize-handle {\n    display: none;\n  }\n\n  .conversation-header {\n    align-items: flex-start;\n    flex-wrap: wrap;\n  }\n\n  .conversation-title-row {\n    flex-wrap: wrap;\n  }\n\n  .conversation-actions {\n    flex-wrap: wrap;\n    justify-content: flex-end;\n  }\n\n  .file-top-bar-control-row,\n  .file-path-bar {\n    align-items: flex-start;\n    flex-wrap: wrap;\n  }\n\n  .file-workspace-body {\n    grid-template-columns: minmax(0, 1fr) 6px minmax(200px, 240px);\n  }\n\n  .file-workspace-body[data-tree-collapsed=\"true\"] {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .conversation-empty-state {\n    gap: 16px;\n    padding: 24px 16px;\n  }\n\n  .conversation-empty-state h2 {\n    max-width: 16rem;\n    font-size: 38px;\n    overflow-wrap: anywhere;\n  }\n\n  .composer-wrap {\n    padding: 0 12px 6px;\n  }\n\n  .clawee-composer {\n    border-radius: 10px;\n  }\n\n  .composer-queue {\n    max-height: 116px;\n    margin-right: 6px;\n    margin-left: 6px;\n    padding-right: 7px;\n    padding-left: 7px;\n    border-radius: 9px 9px 0 0;\n  }\n\n  .composer-toolbar,\n  .composer-left-actions,\n  .composer-right-actions {\n    flex-wrap: wrap;\n  }\n\n  .composer-toolbar {\n    gap: 8px;\n    align-items: flex-start;\n  }\n\n  .composer-left-actions {\n    flex: 1 1 100%;\n  }\n\n  .composer-right-actions {\n    flex: 1 1 100%;\n    justify-content: space-between;\n  }\n\n  .composer-submit-menu {\n    right: 0;\n    left: auto;\n  }\n\n  .composer-select,\n  .composer-model-button {\n    max-width: calc(100vw - 96px);\n  }\n\n  .timeline-queue-state {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 8px;\n  }\n}\n\n@media (max-width: 480px) {\n  html,\n  body,\n  #root {\n    overflow-x: hidden;\n  }\n\n  .clawee-shell,\n  .clawee-shell.has-detail {\n    height: 100dvh;\n    grid-template-rows: minmax(0, 1fr);\n  }\n\n  .clawee-sidebar {\n    max-width: 100%;\n    padding: 10px;\n    overflow: hidden;\n  }\n\n  .sidebar-primary {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .sidebar-project-tree,\n  .sidebar-conversation-tree {\n    max-width: 100%;\n    overflow: hidden;\n  }\n\n  .sidebar-section h2 {\n    padding-inline: 4px;\n  }\n\n  .sidebar-bottom {\n    grid-template-columns: 1fr auto;\n  }\n\n  .conversation-header {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    padding: 10px 12px;\n  }\n\n  .schedule-thread-header {\n    align-items: flex-start;\n  }\n\n  .schedule-thread-main {\n    flex: 1 1 100%;\n  }\n\n  .schedule-thread-actions {\n    margin-left: auto;\n  }\n\n  .schedule-thread-editor-backdrop {\n    padding: 0;\n  }\n\n  .schedule-thread-editor-dialog {\n    width: 100%;\n    height: 100dvh;\n    border: 0;\n    border-radius: 0;\n  }\n\n  .schedule-thread-editor-dialog .schedule-editor,\n  .schedule-thread-editor-loading {\n    padding: 0 12px;\n  }\n\n  .conversation-actions .toolbar-button span {\n    display: none;\n  }\n\n  .file-top-bar,\n  .file-path-bar {\n    padding: 10px 12px;\n  }\n\n  .file-workspace-body {\n    grid-template-columns: 1fr;\n    grid-template-rows: minmax(0, 1fr) minmax(180px, 240px);\n  }\n\n  .file-tree-resize-handle {\n    display: none;\n  }\n\n  .file-workspace-editor {\n    border-right: 0;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .conversation-empty-state h2 {\n    font-size: 30px;\n  }\n\n  .attachment-image-preview-backdrop {\n    padding: 12px;\n  }\n\n  .attachment-image-preview {\n    width: calc(100vw - 32px);\n    height: calc(100dvh - 96px);\n  }\n\n  .attachment-image-preview > button {\n    top: 10px;\n    right: 10px;\n  }\n}\n\n.markdown-prose {\n  min-width: 0;\n  color: var(--text);\n  font-size: 14px;\n  line-height: 1.68;\n  overflow-wrap: anywhere;\n}\n\n.markdown-prose[data-variant=\"assistant\"],\n.markdown-prose[data-variant=\"document\"] {\n  font-size: 15px;\n  line-height: 1.76;\n}\n\n.markdown-prose[data-variant=\"process\"],\n.markdown-prose[data-variant=\"tool\"],\n.markdown-prose[data-variant=\"diagnostic\"] {\n  color: var(--muted);\n  font-size: 12.5px;\n  line-height: 1.58;\n}\n\n.markdown-prose .md-p {\n  margin: 0;\n}\n\n.markdown-prose .md-p + .md-p,\n.markdown-prose .md-p + .md-code-block,\n.markdown-prose .md-code-block + .md-p,\n.markdown-prose .md-p + .md-table-wrap,\n.markdown-prose .md-table-wrap + .md-p {\n  margin-top: 12px;\n}\n\n.markdown-prose .md-h {\n  margin: 22px 0 9px;\n  color: var(--text);\n  font-weight: 700;\n  line-height: 1.3;\n}\n\n.markdown-prose .md-h:first-child {\n  margin-top: 0;\n}\n\n.markdown-prose .md-h1 {\n  font-size: 22px;\n}\n\n.markdown-prose .md-h2 {\n  font-size: 18px;\n}\n\n.markdown-prose .md-h3 {\n  font-size: 15px;\n}\n\n.markdown-prose .md-h4 {\n  font-size: 14px;\n}\n\n.markdown-prose .md-ul,\n.markdown-prose .md-ol {\n  margin: 12px 0;\n  padding-left: 24px;\n}\n\n.markdown-prose .md-ul li,\n.markdown-prose .md-ol li {\n  margin: 5px 0;\n}\n\n.markdown-prose .md-task-list {\n  padding-left: 0;\n  list-style: none;\n}\n\n.markdown-prose .md-task-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n}\n\n.markdown-prose .md-task-check {\n  width: 15px;\n  height: 15px;\n  margin-top: 3px;\n  flex: 0 0 auto;\n}\n\n.markdown-prose .md-quote {\n  margin: 12px 0;\n  padding-left: 12px;\n  border-left: 3px solid var(--border-strong);\n  color: var(--muted);\n}\n\n.markdown-prose .md-inline-code {\n  padding: 1px 4px;\n  border-radius: 5px;\n  background: var(--surface-3);\n  color: var(--text);\n  font-family: var(--font-mono);\n  font-size: 0.9em;\n}\n\n.markdown-prose .md-skill-reference {\n  display: inline-flex;\n  align-items: center;\n  min-height: 22px;\n  padding: 1px 6px;\n  border: 1px solid color-mix(in srgb, var(--accent) 34%, var(--border));\n  border-radius: 5px;\n  background: color-mix(in srgb, var(--accent) 9%, var(--surface));\n  color: var(--accent);\n  font-family: var(--font-mono);\n  font-size: 0.9em;\n  font-weight: 650;\n}\n\n.markdown-prose .md-code-block,\n.detail-code-block,\n.process-code-payload {\n  margin: 12px 0;\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  background: var(--surface-2);\n}\n\n.markdown-prose .md-code-header {\n  min-height: 34px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 6px 10px 6px 12px;\n  border-bottom: 1px solid var(--border);\n}\n\n.markdown-prose .md-code-lang {\n  color: var(--muted);\n  font: 600 11px/1 var(--font-mono);\n  text-transform: lowercase;\n}\n\n.markdown-prose .md-code-actions {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.markdown-prose .md-code-action {\n  min-height: 26px;\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 0 7px;\n  border-radius: 6px;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.markdown-prose .md-code-action:hover {\n  background: var(--surface-3);\n  color: var(--text);\n}\n\n.timeline-item .markdown-prose .md-code,\n.detail-content .markdown-prose .md-code,\n.detail-content .detail-code-block,\n.process-code-payload,\n.markdown-prose .md-code {\n  max-height: none;\n  margin: 0;\n  padding: 12px 14px;\n  overflow: auto;\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  color: var(--text);\n  font: 12.5px/1.62 var(--font-mono);\n  white-space: pre;\n  overflow-wrap: normal;\n}\n\n.detail-content .detail-code-block,\n.process-code-payload {\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  background: var(--surface);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.markdown-prose .md-link {\n  color: var(--accent);\n  text-decoration: none;\n  border-bottom: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);\n}\n\n.markdown-prose .md-link:hover {\n  border-bottom-color: var(--accent);\n}\n\n.markdown-prose .md-hr {\n  margin: 16px 0;\n  border: 0;\n  border-top: 1px solid var(--border);\n}\n\n.md-table-wrap {\n  max-width: 100%;\n  margin: 12px 0;\n  overflow-x: auto;\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  background: var(--surface);\n}\n\n.md-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 12.5px;\n}\n\n.md-table th,\n.md-table td {\n  padding: 8px 10px;\n  border-bottom: 1px solid var(--border);\n  text-align: left;\n  vertical-align: top;\n}\n\n.md-table th {\n  background: var(--surface-2);\n  font-weight: 700;\n}\n\n.md-table tr:last-child td {\n  border-bottom: 0;\n}\n\n.conversation-summary-status {\n  max-width: 220px;\n  color: var(--muted);\n  font-size: 11px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.conversation-summary-backdrop {\n  position: fixed;\n  z-index: 100;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: color-mix(in srgb, var(--shadow-base) 48%, transparent);\n}\n\n.conversation-summary-dialog {\n  width: min(640px, 100%);\n  max-height: min(720px, calc(100vh - 48px));\n  display: grid;\n  grid-template-rows: auto auto minmax(120px, 1fr) auto;\n  gap: 14px;\n  padding: 18px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface);\n  box-shadow: 0 28px 80px color-mix(in srgb, var(--shadow-base) 38%, transparent);\n  overflow: hidden;\n}\n\n.conversation-summary-dialog > header,\n.conversation-summary-dialog > footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.project-management-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 120;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: rgb(0 0 0 / 48%);\n}\n\n.project-management-dialog {\n  width: min(760px, 100%);\n  max-height: min(820px, calc(100vh - 48px));\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface-2);\n  box-shadow: 0 20px 64px rgb(0 0 0 / 32%);\n}\n\n.project-management-dialog > header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 20px;\n  padding: 20px 22px;\n  border-bottom: 1px solid var(--border);\n}\n\n.project-management-dialog h2,\n.project-management-dialog h3,\n.project-management-dialog p {\n  margin: 0;\n}\n\n.project-management-dialog > header p {\n  margin-top: 5px;\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.project-management-body {\n  display: grid;\n  gap: 24px;\n  max-height: calc(100vh - 170px);\n  overflow: auto;\n  padding: 20px 22px 24px;\n}\n\n.project-management-body > section {\n  display: grid;\n  gap: 10px;\n}\n\n.project-management-list {\n  display: grid;\n  gap: 8px;\n}\n\n.project-management-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  min-width: 0;\n  padding: 12px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n}\n\n.project-management-item-copy {\n  display: grid;\n  min-width: 0;\n  gap: 3px;\n}\n\n.project-management-item-copy span {\n  overflow-wrap: anywhere;\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.project-directory-warning {\n  color: var(--warning) !important;\n}\n\n.project-management-actions,\n.project-assignment-controls,\n.project-edit-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.project-management-actions button,\n.project-management-item > button,\n.project-assignment-controls button,\n.project-edit-actions button {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.project-management-empty {\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.project-management-empty-action {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 12px;\n  border: 1px dashed var(--border);\n  border-radius: 6px;\n}\n\n.project-management-empty-action button {\n  min-height: 34px;\n  flex: 0 0 auto;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.project-edit-form {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n  padding: 14px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  background: var(--surface-3);\n}\n\n.project-edit-form h3,\n.project-edit-actions {\n  grid-column: 1 / -1;\n}\n\n.project-edit-form label {\n  display: grid;\n  gap: 5px;\n  font-size: 12px;\n}\n\n.project-edit-form input,\n.project-edit-form select,\n.project-assignment-controls select {\n  min-width: 0;\n  height: 34px;\n  border: 1px solid var(--border);\n  border-radius: 5px;\n  padding: 0 9px;\n  color: var(--text);\n  background: var(--surface-2);\n}\n\n@media (max-width: 720px) {\n  .project-management-backdrop {\n    padding: 0;\n  }\n\n  .project-management-dialog {\n    width: 100%;\n    max-height: 100vh;\n    border-radius: 0;\n  }\n\n  .project-management-item {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .project-management-actions,\n  .project-assignment-controls {\n    flex-wrap: wrap;\n  }\n\n  .project-edit-form {\n    grid-template-columns: 1fr;\n  }\n\n  .project-edit-form h3,\n  .project-edit-actions {\n    grid-column: auto;\n  }\n}\n\n.conversation-summary-dialog > header span {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.conversation-summary-dialog h2 {\n  margin: 2px 0 0;\n  font-size: 18px;\n  letter-spacing: 0;\n}\n\n.conversation-summary-guide {\n  margin: 0;\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.conversation-summary-content {\n  min-height: 0;\n  padding: 14px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  overflow: auto;\n}\n\n.conversation-summary-content p {\n  margin: 0;\n  color: var(--text);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.conversation-summary-dialog > footer {\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n.memory-suggestion {\n  position: relative;\n  z-index: 2;\n  width: min(980px, 100%);\n  display: grid;\n  gap: 8px;\n  margin: 0 auto 10px;\n  padding: 11px 12px;\n  border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));\n  border-radius: 10px;\n  background: color-mix(in srgb, var(--surface) 96%, transparent);\n  box-shadow: 0 16px 42px color-mix(in srgb, var(--shadow-base) 28%, transparent);\n}\n\n.memory-suggestion__title {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  font-size: 13px;\n}\n\n.memory-suggestion__title svg {\n  color: var(--accent);\n}\n\n.memory-suggestion textarea {\n  width: 100%;\n  min-height: 58px;\n  resize: vertical;\n  padding: 8px 9px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--text);\n  font: inherit;\n  line-height: 1.45;\n}\n\n.memory-suggestion__actions {\n  display: flex;\n  align-items: end;\n  justify-content: flex-end;\n  flex-wrap: wrap;\n  gap: 7px;\n}\n\n.memory-suggestion__actions label {\n  min-width: 150px;\n  display: grid;\n  gap: 4px;\n  margin-right: auto;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.memory-suggestion__actions select {\n  height: 32px;\n  padding: 0 8px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--text);\n}\n\n.memory-suggestion__actions button,\n.memory-suggestion__warning button {\n  min-height: 32px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  padding: 0 10px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--text);\n}\n\n.memory-suggestion__actions .memory-suggestion__save {\n  border-color: var(--border-strong);\n  background: var(--accent);\n  color: var(--on-accent);\n}\n\n.memory-suggestion__warning {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 9px;\n  border: 1px solid color-mix(in srgb, var(--warning) 34%, var(--border));\n  border-radius: 7px;\n  color: var(--warning);\n  font-size: 12px;\n}\n\n.memory-suggestion__warning span {\n  min-width: 0;\n  flex: 1;\n}\n\n.run-context__item {\n  display: grid !important;\n  gap: 6px !important;\n  padding: 9px 10px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n}\n\n.run-context__item > div {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 7px;\n}\n\n.run-context__item code {\n  color: var(--muted);\n  font-size: 10px;\n  overflow-wrap: anywhere;\n}\n\n.run-context__item p {\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n@media (max-width: 720px) {\n  .conversation-summary-status {\n    display: none;\n  }\n\n  .memory-suggestion__actions {\n    align-items: stretch;\n  }\n\n  .memory-suggestion__actions label {\n    width: 100%;\