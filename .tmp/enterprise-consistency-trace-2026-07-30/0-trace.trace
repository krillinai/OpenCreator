6, 0.7);\n  --logo-filter: grayscale(1) contrast(1.08) brightness(1.08);\n  --radius: 10px;\n  --font: -apple-system, BlinkMacSystemFont, \"Segoe UI\", system-ui, sans-serif;\n  --font-display: Georgia, \"Times New Roman\", ui-serif, serif;\n  --font-mono: \"SF Mono\", \"JetBrains Mono\", \"IBM Plex Mono\", ui-monospace, Menlo, Consolas, monospace;\n}\n\n:root[data-theme=\"light\"] {\n  color-scheme: light;\n  --bg: #fafafa;\n  --conversation-bg: #fafafa;\n  --sidebar: #ededee;\n  --sidebar-hover: #e1e1e3;\n  --surface: #fafafa;\n  --surface-2: #f0f0f1;\n  --surface-3: #e4e4e6;\n  --popover: #fafafa;\n  --border: rgba(24, 24, 27, 0.12);\n  --border-strong: rgba(24, 24, 27, 0.32);\n  --text: #18181b;\n  --muted: rgba(24, 24, 27, 0.68);\n  --subtle: rgba(24, 24, 27, 0.46);\n  --accent: #303035;\n  --accent-strong: #18181b;\n  --accent-soft: rgba(24, 24, 27, 0.08);\n  --accent-glow: rgba(24, 24, 27, 0.14);\n  --on-accent: #f7f7f8;\n  --danger: #3f3f46;\n  --danger-soft: rgba(24, 24, 27, 0.06);\n  --warning: #525256;\n  --warning-soft: rgba(24, 24, 27, 0.055);\n  --success: #27272a;\n  --success-soft: rgba(24, 24, 27, 0.07);\n  --status-connected: #16a34a;\n  --status-connected-soft: rgba(22, 163, 74, 0.14);\n  --status-disconnected: #dc2626;\n  --status-disconnected-soft: rgba(220, 38, 38, 0.12);\n  --shadow-base: #18181b;\n  --shadow: 0 18px 48px rgba(24, 24, 27, 0.12);\n  --control-disabled: linear-gradient(180deg, #e4e4e6, #d8d8db);\n  --control-disabled-text: rgba(24, 24, 27, 0.46);\n  --ambient-glow: rgba(24, 24, 27, 0.07);\n  --scrim: rgba(24, 24, 27, 0.56);\n  --logo-filter: grayscale(1) contrast(1.12) brightness(0.78);\n}\n\n:root[data-accent=\"blue\"] {\n  --accent: #60a5fa;\n  --accent-strong: #93c5fd;\n  --accent-soft: rgba(59, 130, 246, 0.15);\n  --accent-glow: rgba(96, 165, 250, 0.2);\n  --on-accent: #0b1628;\n}\n\n:root[data-theme=\"light\"][data-accent=\"blue\"] {\n  --accent: #2563eb;\n  --accent-strong: #1d4ed8;\n  --accent-soft: rgba(37, 99, 235, 0.1);\n  --accent-glow: rgba(37, 99, 235, 0.16);\n  --on-accent: #f8fafc;\n}\n\n:root[data-accent=\"cyan\"] {\n  --accent: #22d3ee;\n  --accent-strong: #67e8f9;\n  --accent-soft: rgba(6, 182, 212, 0.15);\n  --accent-glow: rgba(34, 211, 238, 0.2);\n  --on-accent: #08212a;\n}\n\n:root[data-theme=\"light\"][data-accent=\"cyan\"] {\n  --accent: #0e7490;\n  --accent-strong: #155e75;\n  --accent-soft: rgba(8, 145, 178, 0.1);\n  --accent-glow: rgba(8, 145, 178, 0.15);\n  --on-accent: #f7feff;\n}\n\n:root[data-accent=\"purple\"] {\n  --accent: #a78bfa;\n  --accent-strong: #c4b5fd;\n  --accent-soft: rgba(139, 92, 246, 0.15);\n  --accent-glow: rgba(167, 139, 250, 0.2);\n  --on-accent: #1b1133;\n}\n\n:root[data-theme=\"light\"][data-accent=\"purple\"] {\n  --accent: #7c3aed;\n  --accent-strong: #6d28d9;\n  --accent-soft: rgba(124, 58, 237, 0.1);\n  --accent-glow: rgba(124, 58, 237, 0.15);\n  --on-accent: #faf8ff;\n}\n\n:root[data-accent=\"orange\"] {\n  --accent: #fb923c;\n  --accent-strong: #fdba74;\n  --accent-soft: rgba(249, 115, 22, 0.15);\n  --accent-glow: rgba(251, 146, 60, 0.2);\n  --on-accent: #2b1405;\n}\n\n:root[data-theme=\"light\"][data-accent=\"orange\"] {\n  --accent: #c2410c;\n  --accent-strong: #9a3412;\n  --accent-soft: rgba(234, 88, 12, 0.1);\n  --accent-glow: rgba(234, 88, 12, 0.15);\n  --on-accent: #fffaf5;\n}\n\n:root[data-accent=\"red\"] {\n  --accent: #f87171;\n  --accent-strong: #fca5a5;\n  --accent-soft: rgba(239, 68, 68, 0.15);\n  --accent-glow: rgba(248, 113, 113, 0.2);\n  --on-accent: #2b0a0a;\n}\n\n:root[data-theme=\"light\"][data-accent=\"red\"] {\n  --accent: #dc2626;\n  --accent-strong: #b91c1c;\n  --accent-soft: rgba(220, 38, 38, 0.1);\n  --accent-glow: rgba(220, 38, 38, 0.15);\n  --on-accent: #fffafa;\n}\n\n:root[data-accent=\"custom\"] {\n  --accent: var(--custom-accent-value);\n  --accent-strong: color-mix(in srgb, var(--custom-accent-value) 88%, var(--text));\n  --accent-soft: color-mix(in srgb, var(--custom-accent-value) 14%, transparent);\n  --accent-glow: color-mix(in srgb, var(--custom-accent-value) 20%, transparent);\n  --on-accent: var(--custom-on-accent);\n}\n\n* {\n  box-sizing: border-box;\n  scrollbar-color: transparent transparent;\n  scrollbar-width: thin;\n}\n\n.is-scrollbar-active {\n  scrollbar-color: color-mix(in srgb, var(--text) 24%, transparent) transparent;\n}\n\n*::-webkit-scrollbar {\n  width: 4px;\n  height: 6px;\n  background: transparent;\n}\n\n*::-webkit-scrollbar-track,\n*::-webkit-scrollbar-track-piece,\n*::-webkit-scrollbar-corner {\n  background: transparent;\n}\n\n*::-webkit-scrollbar-thumb {\n  border-radius: 999px;\n  background-color: transparent;\n}\n\n.is-scrollbar-active::-webkit-scrollbar-thumb {\n  background-color: color-mix(in srgb, var(--text) 22%, transparent);\n}\n\n.is-scrollbar-active::-webkit-scrollbar-thumb:hover {\n  background-color: color-mix(in srgb, var(--text) 34%, transparent);\n}\n\nhtml,\nbody,\n#root {\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  overflow: hidden;\n  background: var(--bg);\n}\n\n.app-drop-shell {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n}\n\n.project-drop-overlay {\n  position: absolute;\n  inset: 12px;\n  z-index: 100;\n  display: grid;\n  place-content: center;\n  justify-items: center;\n  gap: 10px;\n  border: 2px dashed color-mix(in srgb, var(--accent) 72%, var(--border));\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--bg) 84%, var(--accent) 16%);\n  color: var(--text);\n  box-shadow: 0 18px 48px color-mix(in srgb, var(--shadow-base) 34%, transparent);\n  pointer-events: none;\n}\n\n.project-drop-overlay > svg {\n  color: var(--accent-strong);\n}\n\nbody {\n  margin: 0;\n  background: var(--bg);\n  color: var(--text);\n  font: 13px/1.45 var(--font);\n  -webkit-font-smoothing: antialiased;\n  text-rendering: auto;\n}\n\nbutton,\ninput,\ntextarea,\nselect {\n  font: inherit;\n}\n\nbutton {\n  border: 0;\n  color: inherit;\n  background: transparent;\n  cursor: pointer;\n  transition:\n    background 180ms ease,\n    border-color 180ms ease,\n    color 180ms ease,\n    box-shadow 180ms ease,\n    transform 180ms ease;\n}\n\nbutton:disabled {\n  cursor: not-allowed;\n}\n\nbutton:not(:disabled):active {\n  transform: translateY(1px) scale(0.99);\n}\n\nbutton:focus-visible,\ninput:focus-visible,\ntextarea:focus-visible,\nselect:focus-visible {\n  outline: 2px solid var(--accent-strong);\n  outline-offset: 2px;\n}\n\n.workbench-shell {\n  width: 100vw;\n  height: 100vh;\n  min-height: 680px;\n  display: grid;\n  grid-template-columns: 260px minmax(420px, 0.92fr) minmax(520px, 1.08fr) 280px;\n  overflow: hidden;\n  background: var(--surface);\n}\n\n.sidebar-pane,\n.timeline-pane,\n.right-pane,\n.tree-pane {\n  min-width: 0;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: minmax(0, 1fr);\n  border-right: 1px solid var(--border);\n}\n\n.sidebar-pane {\n  background: var(--sidebar);\n}\n\n.timeline-pane,\n.right-pane,\n.tree-pane {\n  background: var(--surface);\n}\n\n.right-pane {\n  background: var(--surface-2);\n}\n\n.tree-pane {\n  grid-template-rows: auto auto minmax(0, 1fr);\n  border-right: 0;\n}\n\n.panel-header {\n  min-height: 50px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 0 14px;\n  border-bottom: 1px solid var(--border);\n  background: var(--surface);\n  color: var(--text);\n}\n\n.panel-title {\n  min-width: 0;\n  display: grid;\n  gap: 1px;\n}\n\n.panel-title strong {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 13px;\n  font-weight: 680;\n}\n\n.panel-title span,\n.panel-subtitle {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.panel-scroll {\n  min-height: 0;\n  overflow: auto;\n  color: var(--text);\n}\n\n.panel-scroll > h2 {\n  margin: 0 0 10px;\n  padding: 28px 24px 0;\n  font-family: var(--font-display);\n  font-size: 34px;\n  line-height: 1.05;\n}\n\n.panel-scroll > p,\n.panel-scroll > ul {\n  margin: 0;\n  padding: 0 24px 16px;\n  color: var(--muted);\n  font-size: 14px;\n}\n\n.panel-scroll > ul {\n  display: grid;\n  gap: 10px;\n  list-style: none;\n}\n\n.panel-scroll > ul li {\n  display: grid;\n  gap: 4px;\n  padding: 14px 16px;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: var(--surface);\n}\n\n.panel-scroll > ul span {\n  color: var(--muted);\n  font-family: var(--font-mono);\n  font-size: 12px;\n}\n\n.inline-error {\n  width: min(760px, calc(100% - 32px));\n  margin: 14px auto 0;\n  padding: 10px 12px;\n  border: 1px solid color-mix(in srgb, var(--danger) 42%, var(--border));\n  border-radius: 10px;\n  background: var(--danger-soft);\n  color: var(--danger);\n}\n\n.conversation-toast {\n  position: absolute;\n  z-index: 20;\n  top: 12px;\n  left: 50%;\n  width: min(560px, calc(100% - 32px));\n  padding: 10px 12px;\n  border: 1px solid color-mix(in srgb, var(--danger) 42%, var(--border));\n  border-radius: 8px;\n  background: var(--danger-soft);\n  color: var(--danger);\n  box-shadow: 0 14px 32px color-mix(in srgb, var(--shadow-base) 24%, transparent);\n  transform: translateX(-50%);\n}\n\n.placeholder-page {\n  min-height: 100%;\n  display: grid;\n  place-items: center;\n  padding: 32px;\n  background:\n    radial-gradient(circle at 38% 74%, var(--ambient-glow), transparent 32%),\n    radial-gradient(circle at 68% 78%, var(--accent-soft), transparent 30%),\n    var(--bg);\n  color: var(--text);\n}\n\n.placeholder-page h1 {\n  margin: 0;\n  font-family: var(--font-display);\n  font-size: 48px;\n  line-height: 1.05;\n  text-align: center;\n  text-wrap: balance;\n}\n\n.page-loading {\n  min-height: 100%;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  color: var(--muted);\n}\n\n.button-secondary,\n.connection-summary button,\n.inline-action,\n.editor-save-button,\n.thread-new-button {\n  min-height: 32px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  padding: 0 11px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--surface-2) 86%, transparent);\n  color: var(--text);\n  font-weight: 620;\n  white-space: nowrap;\n}\n\n.button-secondary:hover,\n.connection-summary button:hover,\n.inline-action:hover,\n.editor-save-button:hover,\n.thread-new-button:hover {\n  border-color: color-mix(in srgb, var(--accent-strong) 42%, var(--border));\n  background: var(--surface-3);\n  box-shadow: 0 0 0 3px var(--accent-soft);\n}\n\n.editor-save-button,\n.composer button:not(:disabled) {\n  border-color: color-mix(in srgb, var(--accent) 72%, var(--border));\n  background: linear-gradient(180deg, var(--accent-strong), var(--accent));\n  color: var(--on-accent);\n  box-shadow: 0 10px 28px var(--accent-glow);\n}\n\n.editor-save-button:hover,\n.composer button:not(:disabled):hover {\n  background: var(--accent-strong);\n}\n\n.composer button:disabled,\n.editor-save-button:disabled {\n  border-color: var(--border);\n  background: var(--surface-3);\n  color: var(--subtle);\n}\n\n.sidebar-stack {\n  height: 100%;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: auto auto minmax(0, 1fr);\n}\n\n.product-bar {\n  min-height: 58px;\n  display: grid;\n  grid-template-columns: 32px minmax(0, 1fr);\n  align-items: center;\n  gap: 10px;\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--border);\n}\n\n.product-mark {\n  width: 32px;\n  height: 32px;\n  display: grid;\n  place-items: center;\n  border-radius: 9px;\n  background: linear-gradient(180deg, var(--accent-strong), var(--accent));\n  color: var(--on-accent);\n  font: 760 13px/1 var(--font-mono);\n}\n\n.product-bar strong,\n.product-bar span {\n  display: block;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.product-bar strong {\n  font-size: 13px;\n}\n\n.product-bar span {\n  color: var(--muted);\n  font-size: 11.5px;\n}\n\n.connection-panel {\n  border-bottom: 1px solid var(--border);\n  background: var(--sidebar);\n}\n\n.connection-panel .panel-header {\n  min-height: 48px;\n  background: transparent;\n}\n\n.connection-status {\n  width: 100%;\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-weight: 680;\n}\n\n.connection-status-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 999px;\n  background: var(--subtle);\n  flex: 0 0 auto;\n}\n\n.connection-status-dot.connected {\n  background: var(--status-connected);\n  box-shadow: 0 0 0 3px var(--status-connected-soft);\n}\n\n.connection-status-dot.disconnected,\n.connection-status-dot.invalid_token {\n  background: var(--status-disconnected);\n  box-shadow: 0 0 0 3px var(--status-disconnected-soft);\n}\n\n.connection-summary {\n  display: grid;\n  gap: 9px;\n  padding: 12px;\n  background: color-mix(in srgb, var(--sidebar) 88%, var(--surface));\n}\n\n.composer textarea::placeholder {\n  color: var(--subtle);\n}\n\n.connection-summary p {\n  margin: 0;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.45;\n}\n\n.thread-list {\n  min-height: 0;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n}\n\n.thread-list .panel-header {\n  background: transparent;\n}\n\n.thread-list-scroll {\n  min-height: 0;\n  overflow: auto;\n  padding: 10px;\n}\n\n.session-row {\n  width: 100%;\n  display: grid;\n  gap: 4px;\n  min-height: 48px;\n  padding: 9px 10px;\n  border-radius: 9px;\n  color: var(--text);\n  text-align: left;\n}\n\n.session-row:hover,\n.session-row[aria-current=\"page\"] {\n  background: var(--surface);\n  box-shadow: inset 0 0 0 1px var(--border);\n}\n\n.session-row strong {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-weight: 650;\n}\n\n.session-row span {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.empty-state {\n  min-height: 160px;\n  display: grid;\n  place-items: center;\n  margin: 0;\n  padding: 24px;\n  color: var(--muted);\n  text-align: center;\n}\n\n.timeline-empty {\n  max-width: 360px;\n  min-height: 118px;\n  display: grid;\n  align-content: center;\n  gap: 6px;\n  margin: 74px auto 0;\n  padding: 22px;\n  border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n  border-radius: 14px;\n  background: color-mix(in srgb, var(--surface) 72%, transparent);\n  color: var(--muted);\n  text-align: left;\n}\n\n.timeline-empty strong {\n  color: var(--text);\n  font-size: 14px;\n}\n\n.timeline-empty span {\n  color: var(--muted);\n  font-size: 12.5px;\n}\n\n.empty-state.compact {\n  min-height: 96px;\n  place-items: start;\n  padding: 14px 10px;\n  text-align: left;\n}\n\n.timeline-shell {\n  height: 100%;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  overflow: hidden;\n  background: var(--surface);\n}\n\n.timeline-head {\n  min-height: 50px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 0 18px;\n  border-bottom: 1px solid var(--border);\n  background: var(--surface);\n}\n\n.timeline-head strong {\n  display: block;\n  font-size: 13px;\n}\n\n.timeline-head span {\n  display: block;\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.timeline-list {\n  height: 100%;\n  min-height: 0;\n  overflow: hidden;\n  background: var(--conversation-bg);\n}\n\n.timeline-stack {\n  max-width: 960px;\n  margin: 0 auto;\n  display: grid;\n  gap: 28px;\n}\n\n.timeline-virtual-shell,\n.timeline-virtuoso {\n  height: 100%;\n  min-height: 0;\n}\n\n.timeline-virtual-shell {\n  position: relative;\n}\n\n.timeline-virtual-item {\n  width: 100%;\n  max-width: 960px;\n  margin: 0 auto;\n  padding: 8px clamp(18px, 5vw, 72px);\n}\n\n.timeline-end-spacer {\n  min-height: clamp(72px, 10vh, 112px);\n}\n\n.timeline-load-older {\n  min-height: 52px;\n  display: grid;\n  place-items: center;\n  padding: 12px 18px 2px;\n}\n\n.timeline-load-older:empty {\n  min-height: 20px;\n  padding: 0;\n}\n\n.timeline-load-older .inline-action {\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n}\n\n.timeline-new-content {\n  position: absolute;\n  right: clamp(18px, 5vw, 72px);\n  bottom: 18px;\n  z-index: 2;\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  min-height: 34px;\n  padding: 7px 11px;\n  border: 1px solid var(--border-strong);\n  border-radius: 8px;\n  background: var(--surface-2);\n  color: var(--text);\n  box-shadow: 0 12px 32px color-mix(in srgb, var(--shadow-base) 36%, transparent);\n  font-size: 12.5px;\n  font-weight: 650;\n}\n\n.timeline-new-content:hover {\n  border-color: color-mix(in srgb, var(--accent) 42%, var(--border-strong));\n  background: var(--surface-3);\n}\n\n.timeline-item {\n  min-width: 0;\n  display: grid;\n  gap: 6px;\n}\n\n.timeline-item[data-search-target=\"true\"] {\n  border-radius: var(--radius);\n  background: color-mix(in srgb, var(--accent) 14%, transparent);\n  box-shadow: inset 3px 0 0 var(--accent);\n}\n\n.timeline-item-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.timeline-avatar {\n  width: 26px;\n  height: 26px;\n  display: inline-grid;\n  place-items: center;\n  border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n  border-radius: 8px;\n  background: var(--surface-3);\n  color: var(--text);\n  font: 700 11px/1 var(--font-mono);\n  flex: 0 0 auto;\n}\n\n.timeline-avatar-logo {\n  width: 24px;\n  height: 24px;\n  display: block;\n  background-image: url('/logo-v2-white-logo.svg');\n  background-position: calc(50% - 1px) center;\n  background-size: 46px 46px;\n  background-repeat: no-repeat;\n}\n\n:root[data-theme=\"light\"] .timeline-avatar-logo {\n  background-image: url('/logo-v2-black-logo.svg');\n}\n\n.timeline-kind {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-weight: 650;\n}\n\n.timeline-bubble {\n  max-width: 820px;\n  min-width: 0;\n  display: grid;\n  gap: 8px;\n  padding: 18px 20px;\n  border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n  border-radius: 16px;\n  background: color-mix(in srgb, var(--surface-3) 88%, transparent);\n  color: var(--text);\n  box-shadow: 0 18px 46px color-mix(in srgb, var(--shadow-base) 28%, transparent);\n  backdrop-filter: blur(16px);\n}\n\n.timeline-assistant_message .timeline-avatar {\n  border-color: transparent;\n  background: transparent;\n  box-shadow: none;\n}\n\n.timeline-assistant_message .timeline-item-header {\n  gap: 4px;\n}\n\n.timeline-assistant_message .timeline-kind {\n  font-size: 13px;\n  font-weight: 680;\n}\n\n.timeline-user_message {\n  justify-items: end;\n}\n\n.timeline-user_message .timeline-item-header {\n  flex-direction: row-reverse;\n}\n\n.timeline-user_message .timeline-bubble {\n  border: 0;\n  border-top-right-radius: 0;\n  background: color-mix(in srgb, var(--surface-3) 86%, var(--accent) 14%);\n}\n\n:root[data-theme=\"light\"] .timeline-user_message .timeline-bubble {\n  background: #f2f2f2;\n}\n\n.timeline-message-meta {\n  min-height: 24px;\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 4px;\n  padding: 0 4px;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 120ms ease;\n}\n\n.timeline-user_message:hover .timeline-message-meta,\n.timeline-user_message:focus-within .timeline-message-meta,\n.timeline-assistant_message:hover .timeline-message-meta,\n.timeline-assistant_message:focus-within .timeline-message-meta,\n.timeline-message-meta.is-latest-assistant {\n  opacity: 1;\n  pointer-events: auto;\n}\n\n.timeline-message-meta.is-latest-assistant time {\n  opacity: 0;\n  transition: opacity 120ms ease;\n}\n\n.timeline-assistant_message:hover .timeline-message-meta.is-latest-assistant time,\n.timeline-assistant_message:focus-within .timeline-message-meta.is-latest-assistant time {\n  opacity: 1;\n}\n\n.timeline-message-meta time {\n  margin-right: 4px;\n  color: var(--subtle);\n  font-size: 12px;\n  line-height: 24px;\n}\n\n.timeline-message-meta button {\n  width: 26px;\n  height: 24px;\n  display: inline-grid;\n  place-items: center;\n  border-radius: 6px;\n  color: var(--muted);\n}\n\n.timeline-message-meta button:hover {\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n  color: var(--text);\n}\n\n@media (hover: none) {\n  .timeline-message-meta {\n    opacity: 1;\n    pointer-events: auto;\n  }\n}\n\n.timeline-schedule_trigger .timeline-avatar {\n  color: var(--warning);\n}\n\n.timeline-schedule_trigger .timeline-bubble {\n  border-color: color-mix(in srgb, var(--warning) 28%, var(--border));\n  border-top-left-radius: 0;\n  background: color-mix(in srgb, var(--surface-2) 92%, var(--warning) 8%);\n}\n\n.timeline-schedule-trigger-content {\n  min-width: 0;\n  display: grid;\n  gap: 10px;\n}\n\n.timeline-schedule-trigger-content time {\n  color: var(--muted);\n  font: 500 12px/1.4 var(--font-mono);\n}\n\n.timeline-message-attachments {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(128px, 220px));\n  gap: 8px;\n}\n\n.timeline-message-attachments figure {\n  min-width: 0;\n  margin: 0;\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--conversation-bg) 52%, transparent);\n}\n\n.timeline-message-attachments img {\n  width: 100%;\n  aspect-ratio: 4 / 3;\n  display: block;\n  object-fit: cover;\n}\n\n.timeline-message-attachments figcaption {\n  min-width: 0;\n  display: grid;\n  gap: 2px;\n  padding: 7px 8px;\n}\n\n.timeline-message-attachments strong,\n.timeline-message-attachments span {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.timeline-message-attachments span {\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.timeline-queue-state {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding-top: 8px;\n  border-top: 1px solid var(--border);\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.timeline-queue-state span {\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.timeline-queue-state button {\n  flex: 0 0 auto;\n  min-height: 28px;\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 0 8px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.timeline-queue-state button:hover {\n  border-color: color-mix(in srgb, var(--danger) 44%, var(--border));\n  color: var(--text);\n}\n\n.timeline-assistant_message .timeline-bubble {\n  width: 100%;\n  max-width: 900px;\n  padding: 2px 0 10px;\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  box-shadow: none;\n  backdrop-filter: none;\n}\n\n.timeline-tool_step .timeline-bubble,\n.timeline-run_status .timeline-bubble,\n.timeline-done .timeline-bubble,\n.timeline-diagnostic .timeline-bubble {\n  border-bottom-left-radius: 4px;\n}\n\n.timeline-change_card .timeline-bubble {\n  border-color: color-mix(in srgb, var(--success) 30%, var(--border));\n  background: var(--success-soft);\n}\n\n.timeline-approval .timeline-bubble {\n  border-color: color-mix(in srgb, var(--warning) 34%, var(--border));\n  background: color-mix(in srgb, #f59e0b 8%, var(--surface-2));\n}\n\n.approval-panel {\n  min-width: 0;\n  display: grid;\n  gap: 12px;\n}\n\n.approval-heading {\n  min-width: 0;\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n}\n\n.approval-heading > svg {\n  flex: 0 0 auto;\n  margin-top: 1px;\n  color: var(--warning);\n}\n\n.approval-heading > div {\n  min-width: 0;\n  display: grid;\n  gap: 3px;\n}\n\n.approval-heading strong,\n.approval-heading span,\n.approval-panel > p {\n  overflow-wrap: anywhere;\n}\n\n.approval-heading span {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.approval-panel > p {\n  margin: 0;\n  color: var(--text-secondary);\n  line-height: 1.55;\n}\n\n.approval-details {\n  min-width: 0;\n  display: grid;\n  gap: 8px;\n  margin: 0;\n}\n\n.approval-details > div {\n  min-width: 0;\n  display: grid;\n  grid-template-columns: 76px minmax(0, 1fr);\n  align-items: start;\n  gap: 10px;\n}\n\n.approval-details dt {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.approval-details dd {\n  min-width: 0;\n  margin: 0;\n}\n\n.approval-details code {\n  display: block;\n  max-width: 100%;\n  overflow: auto;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  color: var(--text);\n  font-size: 12px;\n}\n\n.approval-actions {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.approval-actions button {\n  min-height: 34px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  padding: 0 12px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  font-weight: 650;\n}\n\n.approval-actions button:disabled {\n  opacity: 0.58;\n  cursor: wait;\n}\n\n.approval-reject {\n  background: var(--surface-3);\n  color: var(--text-secondary);\n}\n\n.approval-approve {\n  border-color: color-mix(in srgb, var(--accent) 45%, var(--border)) !important;\n  background: var(--accent);\n  color: var(--on-accent);\n}\n\n.timeline-process {\n  max-width: 820px;\n  color: var(--muted);\n}\n\n.timeline-process details {\n  border-bottom: 1px solid color-mix(in srgb, var(--text) 5%, transparent);\n  border-radius: 0;\n}\n\n.timeline-process details[open] {\n  background: transparent;\n}\n\n.timeline-process summary {\n  min-width: 0;\n  min-height: 32px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 5px 8px;\n  border-radius: 8px;\n  color: var(--muted);\n  font-size: 13px;\n  list-style: none;\n  cursor: pointer;\n}\n\n.timeline-process summary::-webkit-details-marker {\n  display: none;\n}\n\n.timeline-process summary:hover {\n  background: color-mix(in srgb, var(--text) 6%, transparent);\n  color: var(--text);\n}\n\n.timeline-process details[open] summary {\n  border-bottom: 0;\n  background: transparent;\n  color: var(--text);\n}\n\n.process-summary-label {\n  flex: 0 0 auto;\n  color: var(--text);\n  font-weight: 650;\n}\n\n.timeline-process:not(:has(details[open])) summary {\n  width: fit-content;\n}\n\n.process-summary-spinner {\n  flex: 0 0 auto;\n  color: var(--accent);\n  animation: conversation-run-spin 900ms linear infinite;\n}\n\n.process-summary-activity {\n  min-width: 0;\n  flex: 1 1 auto;\n  overflow: hidden;\n  color: var(--muted);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.process-summary-state,\n.process-summary-count {\n  flex: 0 0 auto;\n  color: var(--muted);\n}\n\n.process-detail {\n  display: grid;\n  gap: 12px;\n  padding: 12px 8px 18px;\n}\n\n.process-steps {\n  display: grid;\n  gap: 16px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.process-step {\n  min-width: 0;\n  display: grid;\n  gap: 5px;\n}\n\n.process-step-row {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 7px;\n}\n\n.process-step-row::before {\n  width: 5px;\n  height: 5px;\n  border-radius: 999px;\n  background: var(--border-strong);\n  content: \"\";\n  flex: 0 0 auto;\n}\n\n.process-step-title {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--text);\n  font-size: 12.5px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.process-step-command {\n  width: fit-content;\n  max-width: 100%;\n  margin-left: 12px;\n  padding: 3px 7px;\n  border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--surface-3) 84%, transparent);\n  color: var(--text);\n  font: 12px/1.55 var(--font-mono);\n  overflow-wrap: anywhere;\n  white-space: pre-wrap;\n}\n\n.process-step-severity {\n  padding: 1px 6px;\n  border: 1px solid var(--border);\n  border-radius: 999px;\n  background: var(--surface-2);\n  color: var(--muted);\n  font: 700 10.5px/1.5 var(--font-mono);\n}\n\n.process-step-severity.warning {\n  border-color: color-mix(in srgb, var(--warning) 28%, var(--border));\n  background: var(--warning-soft);\n  color: var(--warning);\n}\n\n.process-step-severity.error {\n  border-color: color-mix(in srgb, var(--danger) 28%, var(--border));\n  background: var(--danger-soft);\n  color: var(--danger);\n}\n\n.process-step-note {\n  padding-left: 13px;\n  color: var(--muted);\n  font: 12px/1.35 var(--font-mono);\n}\n\n.process-reasoning-text {\n  display: grid;\n  gap: 14px;\n  color: var(--text);\n  font-size: 14.5px;\n  line-height: 1.75;\n}\n\n.process-reasoning-text p {\n  margin: 0;\n}\n\n.change-card-content {\n  width: 100%;\n  min-width: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 7px 10px;\n  align-items: center;\n}\n\n.change-card-button {\n  padding: 0;\n  border: 0;\n  background: transparent;\n  color: inherit;\n  cursor: pointer;\n  text-align: left;\n}\n\n.change-card-button:hover strong {\n  text-decoration: underline;\n  text-underline-offset: 2px;\n}\n\n.change-card-button:focus-visible {\n  outline: 2px solid color-mix(in srgb, var(--accent) 42%, transparent);\n  outline-offset: 4px;\n}\n\n.change-card-content strong {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--text);\n  font-size: 13px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.change-card-content span {\n  min-width: 0;\n  grid-column: 1 / -1;\n  overflow-wrap: anywhere;\n  color: var(--muted);\n  font: 12px/1.45 var(--font-mono);\n}\n\n.change-card-content code {\n  justify-self: start;\n  padding: 3px 7px;\n  border: 1px solid color-mix(in srgb, var(--success) 28%, var(--border));\n  border-radius: 999px;\n  background: var(--surface);\n  color: var(--success);\n  font: 700 11px/1 var(--font-mono);\n}\n\n.change-card-action {\n  grid-column: 2;\n  grid-row: 1;\n  justify-self: end;\n  padding: 6px 12px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface);\n  color: var(--text);\n  font-size: 13px;\n  font-weight: 650;\n  line-height: 1;\n}\n\n.change-card-group {\n  grid-template-columns: minmax(0, 1fr) auto;\n}\n\n.change-card-paths {\n  grid-column: 1 / -1;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 7px;\n}\n\n.change-card-path-button,\n.change-card-paths code {\n  max-width: 100%;\n  padding: 4px 7px;\n  border: 1px solid color-mix(in srgb, var(--success) 24%, var(--border));\n  border-radius: 6px;\n  background: var(--surface);\n  color: var(--text);\n  font: 11.5px/1.4 var(--font-mono);\n  overflow-wrap: anywhere;\n  text-align: left;\n}\n\n.change-card-path-button {\n  cursor: pointer;\n}\n\n.change-card-path-button:hover {\n  border-color: color-mix(in srgb, var(--success) 46%, var(--border));\n}\n\n.timeline-item p {\n  margin: 0;\n}\n\n.timeline-item pre,\n.run-detail pre {\n  max-height: 280px;\n  margin: 0;\n  padding: 10px;\n  overflow: auto;\n  border-radius: 8px;\n  background: var(--conversation-bg);\n  color: var(--text);\n  font: 12px/1.55 var(--font-mono);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.inline-action {\n  justify-self: start;\n}\n\n.composer {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 10px;\n  padding: 12px 18px 16px;\n  border-top: 1px solid var(--border);\n  background: linear-gradient(180deg, transparent, var(--surface) 24%);\n}\n\n.composer textarea {\n  min-height: 76px;\n  max-height: 150px;\n  resize: vertical;\n  padding: 11px 12px;\n  border: 1px solid var(--border-strong);\n  border-radius: 12px;\n  background: var(--surface);\n  color: var(--text);\n  box-shadow: 0 12px 34px color-mix(in srgb, var(--shadow-base) 24%, transparent);\n}\n\n.composer button {\n  align-self: end;\n  min-height: 38px;\n  min-width: 62px;\n  padding: 0 14px;\n  border: 1px solid color-mix(in srgb, var(--accent) 72%, var(--border));\n  border-radius: 10px;\n  font-weight: 680;\n}\n\n.file-editor {\n  height: 100%;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  background: var(--surface-2);\n}\n\n.file-editor-head {\n  min-height: 50px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 0 16px;\n  border-bottom: 1px solid var(--border);\n  background: var(--surface);\n}\n\n.file-editor-title {\n  min-width: 0;\n  display: grid;\n  gap: 1px;\n}\n\n.file-editor-title strong {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 13px;\n}\n\n.save-state {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.save-state.dirty {\n  color: var(--warning);\n}\n\n.file-editor-errors {\n  display: grid;\n  gap: 2px;\n  color: var(--danger);\n  font-size: 12px;\n}\n\n.file-editor-body {\n  min-height: 0;\n  overflow: auto;\n  padding: 18px;\n}\n\n.editor-card {\n  height: 100%;\n  min-height: 0;\n  max-width: 1040px;\n  margin: 0 auto;\n  display: grid;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: var(--surface);\n  box-shadow: 0 1px 2px color-mix(in srgb, var(--shadow-base) 5%, transparent);\n  overflow: hidden;\n}\n\n.code-textarea {\n  width: 100%;\n  height: 100%;\n  min-height: 480px;\n  resize: none;\n  border: 0;\n  outline: 0;\n  padding: 16px 18px 28px;\n  background: var(--surface);\n  color: var(--text);\n  font: 12.5px/1.7 var(--font-mono);\n  white-space: pre-wrap;\n  tab-size: 2;\n}\n\n.tree-header {\n  min-height: 50px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 0 14px;\n  border-bottom: 1px solid var(--border);\n}\n\n.tree-header strong {\n  font-weight: 680;\n}\n\n.tree-search {\n  padding: 10px 12px;\n  border-bottom: 1px solid var(--border);\n}\n\n.tree-search input {\n  width: 100%;\n  height: 32px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  padding: 0 10px;\n  background: var(--surface-2);\n  color: var(--text);\n}\n\n.tree-list {\n  min-height: 0;\n  overflow: auto;\n  padding: 8px;\n}\n\n.tree-list ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.tree-folder,\n.tree-file {\n  width: 100%;\n  min-height: 30px;\n  display: grid;\n  grid-template-columns: 18px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 7px;\n  border-radius: 7px;\n  padding: 0 8px;\n  color: var(--muted);\n  text-align: left;\n}\n\n.tree-file {\n  color: var(--text);\n}\n\n.tree-file:hover,\n.tree-folder:hover,\n.tree-file[aria-current=\"page\"] {\n  background: var(--surface-3);\n}\n\n.tree-file[aria-current=\"page\"] {\n  box-shadow: inset 2px 0 0 var(--accent);\n}\n\n.tree-icon {\n  color: var(--subtle);\n  font: 700 10px/1 var(--font-mono);\n}\n\n.tree-name {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.tree-kind {\n  color: var(--subtle);\n  font: 10px/1 var(--font-mono);\n  text-transform: uppercase;\n  max-width: 54px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.file-tree-panel {\n  width: auto;\n  min-width: 0;\n  max-width: none;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  background: var(--surface);\n}\n\n.file-search {\n  position: relative;\n  display: block;\n  padding: 10px 12px 8px;\n  border-bottom: 1px solid var(--border);\n}\n\n.file-search-label {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.file-search-icon {\n  position: absolute;\n  left: 22px;\n  top: 50%;\n  transform: translateY(-35%);\n  color: var(--subtle);\n  pointer-events: none;\n}\n\n.file-search input {\n  width: 100%;\n  height: 34px;\n  padding: 0 12px 0 34px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface-2);\n  color: var(--text);\n}\n\n.file-tree-list,\n.file-tree-list ul {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.file-tree-list {\n  min-height: 0;\n  overflow: auto;\n  padding: 8px;\n}\n\n.file-tree-row {\n  width: 100%;\n  min-height: 32px;\n  display: grid;\n  grid-template-columns: 30px minmax(0, 1fr);\n  align-items: center;\n  gap: 0;\n  border-radius: 8px;\n  color: var(--text);\n  text-align: left;\n  white-space: nowrap;\n}\n\n.file-tree-row:hover {\n  background: var(--surface-3);\n}\n\n.file-tree-row[aria-current=\"page\"] {\n  background: var(--accent-soft);\n  box-shadow: inset 2px 0 0 var(--accent);\n}\n\n.file-tree-row-leading {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  color: var(--subtle);\n}\n\n.file-tree-row-leading .is-expanded {\n  transform: rotate(90deg);\n}\n\n.file-tree-row-name {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.file-tree-empty {\n  margin: 0;\n  padding: 18px 14px;\n  color: var(--muted);\n}\n\n.file-tree-warning {\n  margin: 2px 0 6px;\n  color: var(--warning);\n  font-size: 12px;\n}\n\n.file-editor-pane {\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  display: grid;\n  grid-template-rows: auto auto minmax(0, 1fr);\n  background: var(--surface);\n}\n\n.file-editor-pane[data-toolbar=\"hidden\"] {\n  grid-template-rows: auto minmax(0, 1fr);\n}\n\n.file-editor-pane[data-toolbar=\"hidden\"] > .text-file-editor,\n.file-editor-pane[data-toolbar=\"hidden\"] > .file-preview,\n.file-editor-pane[data-toolbar=\"hidden\"] > .unsupported-file-state {\n  grid-row: 2;\n}\n\n.file-editor-toolbar {\n  min-height: 54px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 10px 14px;\n  border-bottom: 1px solid var(--border);\n  background: var(--surface);\n}\n\n.file-editor-toolbar-main,\n.file-editor-toolbar-actions,\n.file-editor-toolbar-title {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.file-editor-toolbar-title {\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 2px;\n}\n\n.file-editor-toolbar-title strong,\n.file-editor-toolbar-title span {\n  min-width: 0;\n  max-width: 100%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.file-editor-toolbar-title span {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.file-editor-mode-toggle {\n  display: inline-flex;\n  align-items: center;\n  padding: 2px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface-2);\n}\n\n.file-editor-mode-toggle button {\n  min-width: 56px;\n  min-height: 28px;\n  padding: 0 10px;\n  border-radius: 6px;\n  color: var(--muted);\n}\n\n.file-editor-mode-toggle button[aria-pressed=\"true\"] {\n  background: linear-gradient(\n    180deg,\n    color-mix(in srgb, var(--accent-strong) 84%, var(--surface)) 0%,\n    color-mix(in srgb, var(--accent) 88%, var(--surface)) 100%\n  );\n  color: var(--on-accent);\n  box-shadow:\n    0 0 0 1px color-mix(in srgb, var(--accent-strong) 52%, transparent),\n    0 8px 18px color-mix(in srgb, var(--accent-glow) 58%, transparent);\n}\n\n.text-file-editor,\n.text-file-editor-host,\n.file-preview {\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n}\n\n.text-file-editor {\n  overflow: hidden;\n}\n\n.text-file-editor-host .cm-editor {\n  height: 100%;\n}\n\n.file-preview {\n  overflow: auto;\n  padding: 16px;\n}\n\n.file-preview pre {\n  margin: 0;\n  white-space: pre-wrap;\n  word-break: break-word;\n  font: 12.5px/1.55 var(--font-mono);\n}\n\n.file-preview-empty {\n  display: grid;\n  place-items: center;\n  color: var(--muted);\n}\n\n.file-preview-media {\n  display: grid;\n  place-items: center;\n  background: var(--surface-2);\n}\n\n.file-preview-media img,\n.file-preview-media object {\n  max-width: 100%;\n  max-height: 100%;\n}\n\n.file-preview-html {\n  height: 100%;\n  align-self: stretch;\n  display: grid;\n  grid-template-rows: minmax(0, 1fr) auto;\n  overflow: hidden;\n  padding: 0;\n  background: #fff;\n}\n\n.file-preview-html iframe {\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  display: block;\n  border: 0;\n  background: #fff;\n}\n\n.file-preview-html-status {\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  color: var(--muted);\n  font-size: 13px;\n  text-align: center;\n}\n\n.html-preview-external-links {\n  min-width: 0;\n  display: flex;\n  gap: 6px;\n  overflow-x: auto;\n  padding: 6px 8px;\n  border-top: 1px solid var(--border);\n  background: var(--surface);\n}\n\n.html-preview-external-links button {\n  min-width: 0;\n  max-width: 240px;\n  min-height: 28px;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 0 8px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.html-preview-external-links button:hover {\n  color: var(--text);\n}\n\n.html-preview-external-links span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.file-preview-note {\n  margin: 0 0 12px;\n  color: var(--warning);\n}\n\n.unsupported-file-state {\n  min-height: 0;\n  display: grid;\n  grid-template-columns: 40px minmax(0, 1fr);\n  gap: 12px;\n  align-content: start;\n  padding: 20px 16px;\n}\n\n.unsupported-file-state-icon {\n  width: 40px;\n  height: 40px;\n  display: grid;\n  place-items: center;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface-2);\n  color: var(--muted);\n}\n\n.unsupported-file-state-copy {\n  min-width: 0;\n  display: grid;\n  gap: 4px;\n}\n\n.unsupported-file-state-copy strong,\n.unsupported-file-state-copy span,\n.unsupported-file-state-copy p {\n  margin: 0;\n}\n\n.unsupported-file-state-copy span {\n  color: var(--muted);\n}\n\n.dirty-indicator {\n  padding: 0 8px;\n  min-height: 22px;\n  display: inline-flex;\n  align-items: center;\n  border-radius: 999px;\n  background: var(--warning-soft);\n  color: var(--warning);\n  font-size: 12px;\n  font-weight: 620;\n}\n\n.file-error-bar {\n  min-height: 0;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px 12px;\n  padding: 8px 14px;\n  border-bottom: 1px solid color-mix(in srgb, var(--danger) 28%, var(--border));\n  background: var(--danger-soft);\n  color: var(--danger);\n  font-size: 12px;\n}\n\n.run-detail {\n  min-height: 0;\n  display: grid;\n  gap: 12px;\n}\n\n.run-detail-card {\n  display: grid;\n  gap: 14px;\n  padding: 14px;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: var(--surface);\n}\n\n.run-detail__header {\n  min-width: 0;\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.run-detail__header > div {\n  min-width: 0;\n  display: grid;\n  gap: 4px;\n}\n\n.run-detail__header .toolbar-button {\n  flex: 0 0 auto;\n}\n\n.run-diagnostics-confirm {\n  min-width: 0;\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  gap: 8px 10px;\n  padding: 11px;\n  border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--border));\n  border-radius: 8px;\n  background: var(--accent-soft);\n}\n\n.run-diagnostics-confirm > div:first-of-type {\n  min-width: 0;\n  display: grid;\n  gap: 3px;\n}\n\n.run-diagnostics-confirm > div:last-child {\n  grid-column: 2;\n  display: flex;\n  justify-content: flex-end;\n  gap: 5px;\n}\n\n.run-detail h2,\n.run-detail h3 {\n  margin: 0;\n}\n\n.run-detail h2 {\n  font-size: 16px;\n}\n\n.run-detail h3 {\n  font-size: 13px;\n}\n\n.run-detail p,\n.run-detail ul,\n.run-detail dl {\n  margin: 0;\n}\n\n.run-detail dl {\n  display: grid;\n  grid-template-columns: 120px minmax(0, 1fr);\n  gap: 8px 12px;\n}\n\n.run-detail dt {\n  color: var(--muted);\n}\n\n.run-detail dd {\n  min-width: 0;\n  margin: 0;\n  overflow-wrap: anywhere;\n}\n\n.detail-run .detail-content > .run-detail {\n  min-height: 100%;\n}\n\n.detail-run .run-detail pre {\n  min-height: 0;\n}\n\n.run-detail details {\n  min-width: 0;\n  display: grid;\n  gap: 8px;\n}\n\n.run-detail summary {\n  cursor: pointer;\n  overflow-wrap: anywhere;\n}\n\n.run-detail section > ul {\n  display: grid;\n  gap: 6px;\n  padding-left: 0;\n  list-style: none;\n}\n\n.run-detail section > ul li {\n  min-width: 0;\n  display: flex;\n  align-items: flex-start;\n  gap: 7px;\n  overflow-wrap: anywhere;\n}\n\n.run-detail section > ul svg {\n  flex: 0 0 auto;\n  margin-top: 2px;\n  color: var(--warning);\n}\n\n.run-detail .run-detail-attachments {\n  padding-left: 0;\n}\n\n.run-detail-attachments li > span {\n  min-width: 0;\n  display: grid;\n  gap: 2px;\n}\n\n.run-detail-attachments strong,\n.run-detail-attachments small {\n  overflow-wrap: anywhere;\n}\n\n.run-detail-attachments small {\n  color: var(--muted);\n}\n\n@media (max-width: 720px) {\n  .run-detail__header {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .run-detail__header .toolbar-button {\n    align-self: flex-start;\n  }\n\n  .run-diagnostics-confirm {\n    grid-template-columns: 1fr;\n  }\n\n  .run-diagnostics-confirm > div:last-child {\n    grid-column: 1;\n  }\n\n  .run-detail dl {\n    grid-template-columns: 1fr;\n    gap: 4px;\n  }\n\n  .run-detail dd + dt {\n    margin-top: 6px;\n  }\n}\n\n@media (max-width: 1180px) {\n  .workbench-shell {\n    height: auto;\n    min-height: 100vh;\n    grid-template-columns: 240px minmax(0, 1fr);\n    grid-template-rows: minmax(620px, 100vh) minmax(520px, 80vh) minmax(360px, auto);\n    overflow: visible;\n  }\n\n  .sidebar-pane {\n    grid-row: 1;\n  }\n\n  .timeline-pane {\n    grid-row: 1;\n    border-right: 0;\n  }\n\n  .right-pane,\n  .tree-pane {\n    grid-column: 1 / -1;\n    border-top: 1px solid var(--border);\n    border-right: 0;\n  }\n\n  .right-pane {\n    grid-row: 2;\n  }\n\n  .tree-pane {\n    grid-row: 3;\n  }\n}\n\n@media (max-width: 760px) {\n  .workbench-shell {\n    display: block;\n  }\n\n  .sidebar-pane,\n  .timeline-pane,\n  .right-pane,\n  .tree-pane {\n    min-height: auto;\n    border-right: 0;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .sidebar-stack,\n  .timeline-shell,\n  .file-editor {\n    min-height: 620px;\n  }\n\n  .timeline-list,\n  .file-editor-body {\n    padding: 0;\n  }\n\n  .timeline-virtual-item {\n    padding: 10px 12px;\n  }\n\n  .timeline-new-content {\n    right: 12px;\n    bottom: 12px;\n  }\n\n  .change-card-content {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .change-card-action {\n    grid-column: 1;\n    grid-row: auto;\n    justify-self: start;\n  }\n\n  .composer {\n    grid-template-columns: 1fr;\n    padding: 12px;\n  }\n\n  .composer button {\n    width: 100%;\n  }\n}\n\n.clawee-shell {\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  display: grid;\n  grid-template-columns: 248px minmax(0, 1fr);\n  overflow: hidden;\n  background: var(--bg);\n  color: var(--text);\n}\n\n.clawee-shell.has-detail {\n  grid-template-columns: 248px minmax(0, 1fr) minmax(320px, 400px);\n}\n\n.clawee-shell.sidebar-collapsed {\n  grid-template-columns: 72px minmax(0, 1fr);\n}\n\n.clawee-shell.sidebar-collapsed.has-detail {\n  grid-template-columns: 72px minmax(0, 1fr) minmax(320px, 400px);\n}\n\n.conversation-page {\n  position: relative;\n  isolation: isolate;\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  overflow: hidden;\n  background: var(--conversation-bg);\n}\n\n.conversation-file-layout {\n  position: relative;\n  isolation: isolate;\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  display: grid;\n  grid-template-columns:\n    minmax(\n      420px,\n      min(var(--conversation-pane-width, 34%), calc(100% - 426px))\n    )\n    6px\n    minmax(420px, 1fr);\n  background: var(--bg);\n}\n\n.conversation-file-layout > .conversation-page {\n  border-right: 0;\n}\n\n.pane-resize-handle {\n  position: relative;\n  min-width: 6px;\n  min-height: 0;\n  background: color-mix(in srgb, var(--bg) 80%, transparent);\n  cursor: col-resize;\n  touch-action: none;\n}\n\n.pane-resize-handle::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: 50%;\n  width: 1px;\n  transform: translateX(-50%);\n  background: var(--border);\n  transition: background 160ms ease, width 160ms ease, box-shadow 160ms ease;\n}\n\n.pane-resize-handle:hover::before,\n.pane-resize-handle:focus-visible::before {\n  width: 2px;\n  background: var(--accent);\n  box-shadow: 0 0 18px var(--accent-glow);\n}\n\n.pane-resize-shield {\n  position: fixed;\n  inset: 0;\n  z-index: 2147483647;\n  cursor: col-resize;\n  touch-action: none;\n  background: transparent;\n}\n\nhtml.is-pane-resizing,\nhtml.is-pane-resizing * {\n  cursor: col-resize !important;\n  user-select: none !important;\n}\n\n.conversation-header {\n  min-height: 56px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 10px 22px;\n  border-bottom: 1px solid color-mix(in srgb, var(--text) 6%, transparent);\n  background: var(--conversation-bg);\n}\n\n.conversation-header--task {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n}\n\n.conversation-task-strip {\n  min-width: 0;\n  grid-column: 1 / -1;\n}\n\n.schedule-thread-header {\n  min-width: 0;\n  min-height: 36px;\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px 12px;\n  padding-top: 8px;\n  border-top: 1px solid color-mix(in srgb, var(--text) 6%, transparent);\n}\n\n.schedule-thread-main {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  flex: 1 1 auto;\n  flex-wrap: wrap;\n  gap: 7px 10px;\n}\n\n.schedule-thread-status,\n.schedule-thread-operation {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.schedule-thread-status strong {\n  color: var(--text);\n  font-weight: 650;\n}\n\n.schedule-thread-status[data-status=\"running\"],\n.schedule-thread-status[data-status=\"queued\"],\n.schedule-thread-status[data-status=\"waiting_approval\"] {\n  color: var(--warning);\n}\n\n.schedule-thread-status[data-status=\"failed\"],\n.schedule-thread-status[data-status=\"repair_required\"] {\n  color: var(--danger);\n}\n\n.schedule-thread-status[data-status=\"paused\"] {\n  color: var(--subtle);\n}\n\n.schedule-thread-next {\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n.schedule-thread-actions {\n  display: inline-flex;\n  align-items: center;\n  flex: 0 0 auto;\n  gap: 5px;\n}\n\n.schedule-thread-actions button,\n.schedule-thread-editor-loading header button {\n  width: 30px;\n  height: 30px;\n  display: inline-grid;\n  place-items: center;\n  padding: 0;\n  border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n  border-radius: 7px;\n  background: color-mix(in srgb, var(--surface) 72%, transparent);\n  color: var(--muted);\n}\n\n.schedule-thread-actions button:hover,\n.schedule-thread-editor-loading header button:hover {\n  border-color: color-mix(in srgb, var(--accent-strong) 44%, var(--border));\n  color: var(--text);\n}\n\n.schedule-thread-actions button:disabled {\n  cursor: default;\n  opacity: 0.5;\n}\n\n.schedule-thread-spinner {\n  animation: conversation-run-spin 900ms linear infinite;\n}\n\n.schedule-thread-error {\n  flex: 1 1 100%;\n  margin: 0;\n  color: var(--danger);\n  font-size: 11px;\n}\n\n.schedule-thread-editor-backdrop {\n  position: fixed;\n  z-index: 80;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: var(--scrim);\n  backdrop-filter: blur(10px);\n}\n\n.schedule-thread-editor-dialog {\n  width: min(760px, 100%);\n  height: min(720px, calc(100dvh - 48px));\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--bg);\n  box-shadow: 0 24px 64px color-mix(in srgb, var(--shadow-base) 42%, transparent);\n}\n\n.schedule-thread-editor-dialog .schedule-editor {\n  padding: 0 24px;\n}\n\n.schedule-thread-editor-loading {\n  height: 100%;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  padding: 0 24px;\n}\n\n.schedule-thread-editor-loading header {\n  min-height: 56px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid var(--border);\n}\n\n.schedule-thread-editor-loading > span,\n.schedule-thread-editor-loading > p {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  margin: 0;\n  color: var(--muted);\n}\n\n.schedule-thread-editor-loading > p {\n  color: var(--danger);\n}\n\n.conversation-title {\n  min-width: 0;\n  display: grid;\n  gap: 4px;\n}\n\n.conversation-title-row {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.conversation-title h1 {\n  margin: 0;\n  overflow: hidden;\n  color: var(--text);\n  font-size: 17px;\n  font-weight: 680;\n  line-height: 1.25;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.connection-indicator {\n  width: 8px;\n  height: 8px;\n  flex: 0 0 auto;\n  border-radius: 999px;\n}\n\n.connection-indicator.is-healthy {\n  background: var(--status-connected);\n}\n\n.connection-indicator.is-unhealthy {\n  background: var(--status-disconnected);\n}\n\n.conversation-actions {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  flex: 0 0 auto;\n}\n\n.toolbar-button,\n.icon-button {\n  min-height: 32px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--surface) 72%, transparent);\n  color: var(--text);\n  backdrop-filter: blur(14px);\n}\n\n.toolbar-button {\n  gap: 7px;\n  padding: 0 11px;\n  font-weight: 620;\n}\n\n.icon-button {\n  width: 32px;\n  padding: 0;\n}\n\n.toolbar-button:hover,\n.icon-button:hover {\n  border-color: color-mix(in srgb, var(--accent-strong) 44%, var(--border));\n  background: var(--surface-3);\n  box-shadow: 0 0 0 3px var(--accent-soft);\n}\n\n.file-workspace-view {\n  position: relative;\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  background: var(--surface);\n}\n\n.file-workspace-view.is-empty {\n  grid-template-rows: auto minmax(0, 1fr);\n}\n\n.file-top-bar {\n  min-width: 0;\n  display: grid;\n  grid-template-rows: auto auto;\n  gap: 8px;\n  min-height: 72px;\n  padding: 12px 16px 12px 18px;\n  border-bottom: 1px solid var(--border);\n  background: var(--surface);\n}\n\n.file-path-bar {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 12px 18px;\n  border-bottom: 1px solid var(--border);\n  background: var(--surface);\n}\n\n.file-top-bar-title-row,\n.file-top-bar-control-row,\n.file-top-bar-actions,\n.file-top-bar-title,\n.file-top-bar-path,\n.file-path-actions,\n.file-path-breadcrumbs {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.file-top-bar-title-row {\n  justify-content: space-between;\n  gap: 14px;\n}\n\n.file-top-bar-control-row {\n  justify-content: space-between;\n}\n\n.file-top-bar-actions {\n  justify-content: flex-end;\n  flex: 0 0 auto;\n  gap: 8px;\n}\n\n.file-top-bar-title {\n  max-width: min(520px, 42vw);\n}\n\n.file-top-bar-title strong {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  font-size: 15px;\n  font-weight: 720;\n}\n\n.file-top-bar-path {\n  flex: 1 1 auto;\n  max-width: min(680px, 54vw);\n  color: var(--muted);\n  font-size: 12px;\n  flex-wrap: nowrap;\n}\n\n.file-top-bar-path span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.file-top-bar-path-separator {\n  color: var(--subtle);\n}\n\n.file-toolbar-icon-button {\n  width: 34px;\n  height: 34px;\n}\n\n.file-top-save-button {\n  min-height: 34px;\n  padding: 0 12px;\n}\n\n.file-tab {\n  min-width: 0;\n  max-width: 320px;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 32px;\n  padding: 0 12px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface-2);\n  color: var(--text);\n  font-weight: 620;\n}\n\n.file-tab span:first-child,\n.file-path-breadcrumbs span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.file-tab-dirty {\n  color: var(--warning);\n}\n\n.file-path-breadcrumbs {\n  flex-wrap: wrap;\n  color: var(--muted);\n}\n\n.file-path-breadcrumbs span + span::before {\n  content: \"/\";\n  margin-right: 10px;\n  color: var(--subtle);\n}\n\n.file-workspace-body {\n  min-width: 0;\n  min-height: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 6px minmax(220px, var(--file-tree-width, 280px));\n}\n\n.file-workspace-body[data-tree-collapsed=\"true\"] {\n  grid-template-columns: minmax(0, 1fr);\n}\n\n.file-workspace-editor {\n  min-width: 0;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  border-right: 0;\n  background: var(--surface);\n}\n\n.file-workspace-editor > .file-editor-pane {\n  flex: 1 1 auto;\n  height: auto;\n}\n\n.file-workspace-notice,\n.file-workspace-conflict {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 10px 16px;\n  border-bottom: 1px solid var(--border);\n  background: var(--surface-2);\n  color: var(--muted);\n}\n\n.file-workspace-toast {\n  flex: 0 0 auto;\n  display: inline-flex;\n  align-items: center;\n  min-height: 28px;\n  margin-left: 8px;\n  padding: 0 10px;\n  border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--surface) 92%, transparent);\n  color: var(--text);\n  box-shadow:\n    0 16px 42px color-mix(in srgb, var(--shadow-base) 38%, transparent),\n    0 0 0 1px color-mix(in srgb, var(--text) 4%, transparent) inset;\n  backdrop-filter: blur(16px);\n  font-size: 12px;\n  font-weight: 560;\n  line-height: 1.4;\n  white-space: nowrap;\n  pointer-events: none;\n}\n\n.file-workspace-conflict {\n  background: var(--warning-soft);\n  color: var(--text);\n}\n\n.file-workspace-conflict-actions {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.file-workspace-empty {\n  min-height: 100%;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  color: var(--muted);\n  background: var(--surface);\n}\n\n.conversation-body {\n  position: relative;\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  background: var(--conversation-bg);\n}\n\n.conversation-history-loading {\n  position: absolute;\n  inset: 0;\n  z-index: 3;\n  display: grid;\n  place-items: center;\n  pointer-events: none;\n  background: var(--conversation-bg);\n  color: var(--muted);\n}\n\n.conversation-history-loading span {\n  padding: 6px 10px;\n  border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--surface) 72%, transparent);\n  box-shadow: 0 14px 36px color-mix(in srgb, var(--shadow-base) 32%, transparent);\n  font-size: 12px;\n  font-weight: 560;\n}\n\n.conversation-empty-state {\n  min-height: 100%;\n  display: grid;\n  align-content: center;\n  justify-items: center;\n  gap: 22px;\n  padding: 48px 32px 18px;\n  text-align: center;\n}\n\n.conversation-empty-state h2 {\n  max-width: min(940px, 86vw);\n  margin: 0;\n  color: var(--text);\n  font-family: var(--font-display);\n  font-size: 48px;\n  font-weight: 700;\n  line-height: 1.02;\n  text-wrap: balance;\n  text-shadow: 0 18px 50px color-mix(in srgb, var(--shadow-base) 50%, transparent);\n}\n\n.composer-wrap {\n  position: relative;\n  padding: 0 clamp(18px, 4vw, 52px) 24px;\n  background: transparent;\n}\n\n.composer-stack {\n  width: min(940px, 100%);\n  display: grid;\n  margin: 0 auto;\n}\n\n.clawee-composer {\n  position: relative;\n  z-index: 1;\n  display: grid;\n  gap: 8px;\n  width: 100%;\n  margin: 0;\n  padding: 10px 18px;\n  border: 1px solid var(--border);\n  border-radius: 22px;\n  background: var(--surface);\n}\n\n:root[data-theme=\"light\"] .conversation-empty-state h2 {\n  text-shadow: none;\n}\n\n:root[data-theme=\"light\"] .clawee-composer {\n  border-color: color-mix(in srgb, var(--text) 16%, transparent);\n  background: var(--surface);\n  box-shadow: 0 8px 24px color-mix(in srgb, var(--shadow-base) 8%, transparent);\n  backdrop-filter: none;\n}\n\n:root[data-theme=\"light\"] .clawee-composer .composer-icon-button,\n:root[data-theme=\"light\"] .clawee-composer .composer-send,\n:root[data-theme=\"light\"] .clawee-composer .composer-stop,\n:root[data-theme=\"light\"] .clawee-composer .composer-submit-menu-button {\n  box-shadow: none;\n}\n\n.clawee-composer textarea {\n  min-height: 48px;\n  max-height: 268px;\n  resize: none;\n  overflow-y: hidden;\n  padding: 2px;\n  border: 0;\n  background: transparent;\n  color: var(--text);\n  font-size: 14px;\n  line-height: 22px;\n}\n\n.clawee-composer textarea::placeholder {\n  color: var(--subtle);\n}\n\n.clawee-composer textarea:focus,\n.clawee-composer textarea:focus-visible {\n  outline: none;\n  box-shadow: none;\n}\n\n.composer-project-context {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n}\n\n.composer-project-control {\n  max-width: min(360px, 100%);\n}\n\n.composer-project-button {\n  min-width: 0;\n  max-width: 100%;\n  min-height: 30px;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 0 6px;\n  border: 0;\n  border-radius: 6px;\n  background: transparent;\n  color: color-mix(in srgb, var(--text) 78%, transparent);\n  font-size: 13px;\n  font-weight: 620;\n  line-height: 1;\n}\n\n.composer-project-button:hover {\n  background: color-mix(in srgb, var(--text) 6%, transparent);\n  color: var(--text);\n}\n\n.composer-project-button span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-project-button svg:last-child {\n  flex: 0 0 auto;\n  color: var(--muted);\n}\n\n.composer-project-popover {\n  width: min(312px, calc(100vw - 40px));\n  padding: 8px;\n  overflow: visible;\n}\n\n.composer-project-search {\n  height: 36px;\n  display: grid;\n  grid-template-columns: 18px minmax(0, 1fr);\n  align-items: center;\n  gap: 6px;\n  padding: 0 9px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--conversation-bg) 52%, transparent);\n  color: var(--muted);\n}\n\n.composer-project-search:focus-within {\n  border-color: color-mix(in srgb, var(--accent-strong) 48%, var(--border));\n}\n\n.composer-project-search input {\n  width: 100%;\n  min-width: 0;\n  padding: 0;\n  border: 0;\n  outline: 0;\n  background: transparent;\n  color: var(--text);\n  font-size: 13px;\n}\n\n.composer-project-search input::placeholder {\n  color: var(--subtle);\n}\n\n.composer-project-list {\n  max-height: min(280px, 42vh);\n  margin-top: 6px;\n  overflow-y: auto;\n}\n\n.composer-project-option {\n  width: 100%;\n  min-height: 38px;\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr) 20px;\n  align-items: center;\n  gap: 7px;\n  padding: 7px 9px;\n  border: 0;\n  border-radius: 7px;\n  background: transparent;\n  color: var(--text);\n  text-align: left;\n}\n\n.composer-project-option:hover,\n.composer-project-option[aria-selected=\"true\"] {\n  background: var(--surface-3);\n}\n\n.composer-project-option span {\n  min-width: 0;\n  overflow: hidden;\n  font-size: 13px;\n  font-weight: 560;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-project-check {\n  justify-self: end;\n}\n\n.composer-project-empty {\n  margin: 0;\n  padding: 12px 9px;\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.composer-project-create {\n  position: relative;\n  margin-top: 6px;\n  padding-top: 6px;\n  border-top: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n}\n\n.composer-project-create-trigger,\n.composer-project-create-menu button {\n  width: 100%;\n  min-height: 38px;\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr) 20px;\n  align-items: center;\n  gap: 7px;\n  padding: 7px 9px;\n  border: 0;\n  border-radius: 7px;\n  background: transparent;\n  color: var(--text);\n  text-align: left;\n}\n\n.composer-project-create-trigger:hover,\n.composer-project-create-trigger[aria-expanded=\"true\"],\n.composer-project-create-menu button:hover {\n  background: var(--surface-3);\n}\n\n.composer-project-create-trigger span,\n.composer-project-create-menu span {\n  min-width: 0;\n  overflow: hidden;\n  font-size: 13px;\n  font-weight: 560;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-project-create-trigger svg:last-child {\n  justify-self: end;\n  color: var(--muted);\n}\n\n.composer-project-create-menu {\n  position: absolute;\n  z-index: 32;\n  bottom: -8px;\n  left: calc(100% + 8px);\n  width: 190px;\n  padding: 6px;\n  border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n  border-radius: 10px;\n  background: var(--popover);\n  box-shadow: 0 20px 48px color-mix(in srgb, var(--shadow-base) 38%, transparent);\n}\n\n.composer-project-create-menu button {\n  grid-template-columns: 20px minmax(0, 1fr);\n}\n\n@media (max-width: 720px) {\n  .composer-project-create-menu {\n    right: 0;\n    bottom: calc(100% + 6px);\n    left: auto;\n  }\n}\n\n.composer-input-wrap {\n  position: relative;\n  min-width: 0;\n  display: grid;\n}\n\n.composer-input-wrap.has-skill-chip textarea {\n  min-height: 76px;\n  padding-top: 38px;\n}\n\n.composer-skill-chip {\n  position: absolute;\n  top: 2px;\n  left: 2px;\n  z-index: 1;\n  max-width: calc(100% - 4px);\n  min-height: 30px;\n  display: inline-flex;\n  align-items: center;\n  gap: 7px;\n  padding: 5px 9px;\n  border-radius: 8px;\n  background: var(--surface-3);\n  color: var(--text);\n  pointer-events: none;\n}\n\n.composer-skill-chip strong {\n  min-width: 0;\n  overflow: hidden;\n  font-size: 14px;\n  font-weight: 650;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-file-input {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n.composer-attachment-tray {\n  min-width: 0;\n  display: flex;\n  align-items: flex-start;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.composer-attachment {\n  position: relative;\n  width: 72px;\n  flex: 0 0 72px;\n  aspect-ratio: 1;\n  min-width: 0;\n  overflow: hidden;\n  border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n  border-radius: 8px;\n  background: var(--surface-2);\n}\n\n.clawee-composer button.composer-attachment-preview-trigger:not(:disabled) {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  display: block;\n  overflow: hidden;\n  padding: 0;\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  box-shadow: none;\n  color: inherit;\n  cursor: zoom-in;\n}\n\n.clawee-composer button.composer-attachment-preview-trigger:not(:disabled):hover {\n  background: transparent;\n}\n\n.composer-attachment-preview-trigger img {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n  object-position: center;\n  transition: opacity 140ms ease;\n}\n\n.composer-attachment-preview-trigger:hover img {\n  opacity: 0.88;\n}\n\n.composer-attachment-status {\n  position: absolute;\n  right: 4px;\n  bottom: 4px;\n  left: 4px;\n  min-width: 0;\n  min-height: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  overflow: hidden;\n  padding: 0 5px;\n  border-radius: 5px;\n  background: color-mix(in srgb, var(--popover) 90%, transparent);\n  color: var(--text);\n  font-size: 10px;\n  font-weight: 650;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  pointer-events: none;\n}\n\n.composer-attachment-error .composer-attachment-preview-trigger img {\n  opacity: 0.56;\n}\n\n.composer-attachment-status.composer-attachment-error {\n  color: var(--danger);\n}\n\n.composer-attachment-actions {\n  position: absolute;\n  top: 4px;\n  right: 4px;\n  display: inline-flex;\n  gap: 4px;\n}\n\n.clawee-composer .composer-attachment-actions button:not(:disabled) {\n  width: 20px;\n  height: 20px;\n  display: inline-grid;\n  place-items: center;\n  padding: 0;\n  border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--popover) 92%, transparent);\n  color: var(--muted);\n  box-shadow: none;\n}\n\n.clawee-composer .composer-attachment-actions button:not(:disabled):hover {\n  background: var(--popover);\n  color: var(--text);\n}\n\n.attachment-image-preview-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 130;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: rgb(0 0 0 / 72%);\n}\n\n.attachment-image-preview {\n  position: relative;\n  width: min(960px, 80vw);\n  height: min(720px, 80dvh);\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  outline: none;\n  pointer-events: none;\n}\n\n.attachment-image-preview > img {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  min-width: 0;\n  min-height: 0;\n  max-width: 100%;\n  max-height: 100%;\n  display: block;\n  object-fit: contain;\n  object-position: center;\n  border-radius: 8px;\n  background: transparent;\n  pointer-events: auto;\n}\n\n.attachment-image-preview > button {\n  position: fixed;\n  top: 18px;\n  right: 18px;\n  width: 34px;\n  height: 34px;\n  display: grid;\n  place-items: center;\n  padding: 0;\n  border: 1px solid rgb(255 255 255 / 16%);\n  border-radius: 999px;\n  background: rgb(24 24 27 / 88%);\n  color: #f4f4f5;\n  box-shadow: none;\n  pointer-events: auto;\n}\n\n.attachment-image-preview > button:hover {\n  background: rgb(39 39 42 / 96%);\n}\n\n.composer-menu-notice {\n  max-width: 260px;\n  margin: 0;\n  padding: 6px 10px;\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.45;\n}\n\n.composer-toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  min-width: 0;\n}\n\n.composer-left-actions,\n.composer-right-actions {\n  min-width: 0;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.composer-left-actions {\n  flex: 1 1 auto;\n}\n\n.composer-right-actions {\n  flex: 0 1 auto;\n  justify-content: flex-end;\n}\n\n.composer-control-wrap {\n  position: relative;\n  min-width: 0;\n  display: inline-flex;\n}\n\n.composer-submit-wrap {\n  position: relative;\n  flex: 0 0 auto;\n  display: inline-flex;\n  align-items: stretch;\n}\n\n.composer-icon-button,\n.composer-send,\n.composer-stop {\n  min-height: 38px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n  background: color-mix(in srgb, var(--surface) 88%, transparent);\n  color: color-mix(in srgb, var(--text) 78%, transparent);\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 1;\n  white-space: nowrap;\n  box-shadow:\n    0 10px 28px color-mix(in srgb, var(--shadow-base) 22%, transparent),\n    0 1px 0 color-mix(in srgb, var(--text) 4%, transparent) inset;\n}\n\n.composer-icon-button:hover {\n  border-color: color-mix(in srgb, var(--accent-strong) 34%, var(--border));\n  background: var(--surface-3);\n  color: var(--text);\n  box-shadow:\n    0 12px 30px color-mix(in srgb, var(--shadow-base) 32%, transparent),\n    0 0 0 3px var(--accent-soft);\n}\n\n.composer-icon-button {\n  width: 38px;\n  padding: 0;\n  border-radius: 999px;\n}\n\n.composer-select,\n.composer-model-button {\n  min-height: 34px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 5px;\n  max-width: 220px;\n  padding: 0 2px;\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  color: color-mix(in srgb, var(--text) 70%, transparent);\n  font-size: 14px;\n  font-weight: 560;\n  line-height: 1;\n  white-space: nowrap;\n  box-shadow: none;\n}\n\n.composer-select:hover,\n.composer-model-button:hover {\n  background: transparent;\n  color: var(--text);\n  box-shadow: none;\n}\n\n.composer-select span,\n.composer-model-button span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.composer-select-danger-full-access {\n  color: var(--muted);\n}\n\n.composer-select-danger-full-access:hover {\n  background: transparent;\n  color: var(--text);\n}\n\n.composer-model-button svg:first-child {\n  fill: currentColor;\n  color: var(--success);\n}\n\n.composer-send {\n  width: 38px;\n  height: 38px;\n}\n\n.composer-submit-wrap .composer-send {\n  flex: 0 0 38px;\n}\n\n.composer-submit-wrap:has(.composer-submit-menu-button) .composer-send {\n  border-top-right-radius: 0;\n  border-bottom-right-radius: 0;\n}\n\n.composer-submit-menu-button {\n  width: 24px;\n  min-height: 38px;\n  display: inline-grid;\n  place-items: center;\n  padding: 0;\n  border: 1px solid var(--border-strong);\n  border-left: 1px solid color-mix(in srgb, var(--on-accent) 18%, transparent);\n  border-radius: 0 12px 12px 0;\n  background: var(--accent);\n  color: var(--on-accent);\n}\n\n.composer-submit-menu-button:hover {\n  background: color-mix(in srgb, var(--accent) 90%, var(--text));\n}\n\n.composer-submit-menu {\n  width: min(292px, calc(100vw - 32px));\n}\n\n.composer-stop {\n  width: 38px;\n  height: 38px;\n}\n\n.composer-send,\n.composer-stop {\n  border: 1px solid var(--border-strong);\n  border-radius: 12px;\n  background: var(--accent);\n  color: var(--on-accent);\n  box-shadow:\n    0 10px 22px var(--accent-glow),\n    0 0 0 1px color-mix(in srgb, var(--on-accent) 10%, transparent) inset;\n}\n\n.composer-send:not(:disabled):hover {\n  background: color-mix(in srgb, var(--accent) 90%, var(--text));\n}\n\n.composer-stop {\n  border-radius: 50%;\n  background: color-mix(in srgb, var(--text) 92%, transparent);\n  color: var(--on-accent);\n  box-shadow:\n    0 10px 22px color-mix(in srgb, var(--shadow-base) 30%, transparent),\n    0 0 0 1px color-mix(in srgb, var(--text) 12%, transparent) inset;\n}\n\n.composer-stop:hover {\n  background: var(--accent-strong);\n  color: var(--on-accent);\n}\n\n.composer-send:disabled {\n  border-color: color-mix(in srgb, var(--text) 10%, transparent);\n  background: var(--surface-3);\n  color: var(--control-disabled-text);\n  box-shadow:\n    0 8px 18px color-mix(in srgb, var(--shadow-base) 18%, transparent),\n    0 0 0 1px color-mix(in srgb, var(--text) 4%, transparent) inset;\n}\n\n.composer-stop:disabled {\n  border-color: color-mix(in srgb, var(--text) 12%, transparent);\n  background: var(--control-disabled);\n  color: var(--control-disabled-text);\n  box-shadow: none;\n}\n\n.composer-send svg {\n  color: var(--on-accent);\n  stroke-width: 2.35;\n}\n\n.composer-stop svg {\n  stroke-width: 2;\n}\n\n.composer-send:disabled svg {\n  color: var(--control-disabled-text);\n}\n\n.composer-popover {\n  position: absolute;\n  z-index: 30;\n  bottom: calc(100% + 8px);\n  left: 0;\n  min-width: 232px;\n  padding: 6px;\n  border: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n  border-radius: 14px;\n  background: color-mix(in srgb, var(--popover) 94%, transparent);\n  box-shadow: 0 24px 60px color-mix(in srgb, var(--shadow-base) 46%, transparent);\n  backdrop-filter: blur(20px);\n}\n\n.composer-right-actions .composer-popover {\n  right: 0;\n  left: auto;\n}\n\n.composer-popover-compact {\n  min-width: 168px;\n}\n\n.composer-menu-item {\n  width: 100%;\n  min-height: 38px;\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr);\n  align-items: center;\n  gap: 8px;\n  padding: 8px 10px;\n  border: 0;\n  border-radius: 10px;\n  background: transparent;\n  color: var(--text);\n  text-align: left;\n}\n\n.composer-menu-item:hover {\n  background: var(--surface-3);\n}\n\n.composer-menu-item.is-active {\n  background: var(--surface-3);\n}\n\n.composer-menu-item > span:last-child {\n  min-width: 0;\n  display: grid;\n  gap: 3px;\n}\n\n.composer-menu-item strong {\n  min-width: 0;\n  overflow: hidden;\n  font-size: 13px;\n  font-weight: 690;\n  line-height: 1.2;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-menu-item small {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.25;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-menu-icon {\n  width: 20px;\n  height: 20px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--text);\n}\n\n.composer-slash-menu {\n  right: 0;\n  bottom: calc(100% + 8px);\n  left: 0;\n  max-height: min(360px, 54vh);\n  overflow: auto;\n}\n\n.composer-slash-group {\n  display: grid;\n  gap: 2px;\n}\n\n.composer-slash-group + .composer-slash-group {\n  margin-top: 6px;\n  padding-top: 6px;\n  border-top: 1px solid var(--border);\n}\n\n.composer-slash-group-label {\n  padding: 4px 10px 5px;\n  color: var(--muted);\n  font: 700 11px/1 var(--font-mono);\n  text-transform: none;\n}\n\n.composer-slash-status {\n  padding: 9px 10px;\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.composer-slash-status-error {\n  color: var(--danger);\n}\n\n.composer-slash-item {\n  grid-template-columns: 24px minmax(0, 1fr);\n}\n\n.composer-queue {\n  position: relative;\n  z-index: 0;\n  max-height: 148px;\n  display: grid;\n  overflow-y: auto;\n  margin: 0 14px -1px;\n  padding: 7px 10px 9px;\n  border: 1px solid var(--border);\n  border-bottom: 0;\n  border-radius: 14px 14px 0 0;\n  background: var(--surface);\n}\n\n.composer-queue-item {\n  min-width: 0;\n  min-height: 30px;\n  display: grid;\n  grid-template-columns: 18px minmax(0, 1fr) auto auto auto;\n  align-items: center;\n  gap: 6px;\n  padding: 2px 2px;\n}\n\n.composer-queue-item + .composer-queue-item {\n  border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n}\n\n.composer-queue-leading {\n  width: 18px;\n  height: 18px;\n  display: inline-grid;\n  place-items: center;\n  color: var(--subtle);\n}\n\n.composer-queue-copy {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--text);\n  font-size: 12px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.composer-queue-position {\n  color: var(--muted);\n  font-size: 11px;\n  white-space: nowrap;\n}\n\n.composer-queue-steer,\n.composer-queue-remove {\n  min-height: 24px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 5px;\n  border: 0;\n  border-radius: 5px;\n  background: transparent;\n  color: var(--muted);\n}\n\n.composer-queue-steer {\n  padding: 0 5px;\n  font-size: 11px;\n  font-weight: 600;\n}\n\n.composer-queue-remove {\n  width: 24px;\n  padding: 0;\n}\n\n.composer-queue-steer:hover,\n.composer-queue-remove:hover {\n  background: var(--surface-3);\n  color: var(--text);\n}\n\n.composer-project-name-backdrop {\n  position: fixed;\n  z-index: 100;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: color-mix(in srgb, var(--shadow-base) 46%, transparent);\n}\n\n.composer-project-name-dialog {\n  width: min(420px, 100%);\n  display: grid;\n  gap: 18px;\n  padding: 20px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface);\n  box-shadow: 0 28px 80px color-mix(in srgb, var(--shadow-base) 52%, transparent);\n}\n\n.composer-project-name-dialog header,\n.composer-project-name-dialog label {\n  display: grid;\n  gap: 6px;\n}\n\n.composer-project-name-dialog header strong {\n  font-size: 17px;\n}\n\n.composer-project-name-dialog header span,\n.composer-project-name-dialog label span {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.composer-project-name-dialog input {\n  width: 100%;\n  height: 38px;\n  padding: 0 10px;\n  border: 1px solid var(--border-strong);\n  border-radius: 6px;\n  background: var(--surface-2);\n  color: var(--text);\n  font-size: 14px;\n}\n\n.composer-project-name-dialog footer {\n  display: flex;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.clawee-sidebar-pane,\n.clawee-main-pane,\n.clawee-detail-pane {\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.clawee-sidebar-pane {\n  background: var(--sidebar);\n  border-right: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n}\n\n.clawee-main-pane {\n  display: grid;\n  grid-template-rows: minmax(0, 1fr);\n  background: var(--conversation-bg);\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.clawee-main-content {\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n}\n\n.mobile-navigation-toolbar,\n.mobile-navigation-backdrop,\n.mobile-navigation-close {\n  display: none;\n}\n\n.clawee-detail-pane {\n  background: var(--surface);\n  border-left: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n}\n\n.clawee-sidebar {\n  height: 100%;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: auto auto minmax(0, 1fr) auto auto;\n  gap: 18px;\n  padding: 24px 12px 12px;\n  color: var(--text);\n}\n\n.sidebar-brand {\n  min-width: 0;\n  min-height: 50px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 0 8px 0 6px;\n}\n\n.sidebar-logo-lockup {\n  min-width: 0;\n  height: 50px;\n  display: flex;\n  align-items: center;\n}\n\n.sidebar-logo-image {\n  display: block;\n  object-fit: contain;\n}\n\n.sidebar-logo-full {\n  width: 124px;\n  height: 50px;\n  object-position: left center;\n  transform: translateX(-11px);\n}\n\n.sidebar-logo-mark {\n  width: 38px;\n  height: 38px;\n}\n\n.sidebar-collapse-button,\n.sidebar-brand-button {\n  width: 38px;\n  height: 38px;\n  flex: 0 0 auto;\n  display: grid;\n  place-items: center;\n  padding: 0;\n  border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n  border-radius: 10px;\n  color: color-mix(in srgb, var(--text) 68%, transparent);\n  background: color-mix(in srgb, var(--text) 3.5%, transparent);\n}\n\n.sidebar-collapse-button:hover,\n.sidebar-brand-button:hover {\n  border-color: color-mix(in srgb, var(--text) 14%, transparent);\n  background: color-mix(in srgb, var(--text) 8%, transparent);\n  color: var(--text);\n}\n\n.sidebar-brand-button {\n  position: relative;\n  overflow: hidden;\n  border-color: #1f1f1f;\n  color: #fff;\n  background: #1f1f1f;\n}\n\n.sidebar-brand-button:hover,\n.sidebar-brand-button:focus-visible {\n  border-color: #2c2c2c;\n  color: #fff;\n  background: #2c2c2c;\n}\n\n.sidebar-brand-button .sidebar-logo-image,\n.sidebar-expand-icon {\n  transition:\n    opacity 180ms ease,\n    transform 180ms ease;\n}\n\n.sidebar-expand-icon {\n  position: absolute;\n  opacity: 0;\n  transform: scale(0.84);\n}\n\n.sidebar-brand-button:hover .sidebar-logo-image,\n.sidebar-brand-button:focus-visible .sidebar-logo-image {\n  opacity: 0;\n  transform: scale(0.84);\n}\n\n.sidebar-brand-button:hover .sidebar-expand-icon,\n.sidebar-brand-button:focus-visible .sidebar-expand-icon {\n  opacity: 1;\n  transform: scale(1);\n}\n\n.sidebar-primary,\n.sidebar-section-list,\n.sidebar-project-tree,\n.sidebar-project-node,\n.sidebar-conversation-tree {\n  display: grid;\n  gap: 3px;\n}\n\n.sidebar-section {\n  min-width: 0;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  gap: 8px;\n}\n\n.sidebar-task-section {\n  min-height: 0;\n  max-height: 220px;\n}\n\n.sidebar-task-list {\n  min-height: 0;\n  display: grid;\n  grid-auto-rows: 44px;\n  align-content: start;\n  gap: 3px;\n  overflow-x: hidden;\n  overflow-y: auto;\n  margin-right: -12px;\n  padding-right: 12px;\n}\n\n.sidebar-task-row-shell {\n  min-width: 0;\n  height: 44px;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 28px;\n  align-items: center;\n  gap: 2px;\n}\n\n.sidebar-task-row {\n  width: 100%;\n  min-width: 0;\n  height: 44px;\n  min-height: 44px;\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr) 8px;\n  align-items: center;\n  gap: 6px;\n  padding: 0 8px;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  color: inherit;\n  text-align: left;\n}\n\n.sidebar-task-delete {\n  width: 28px;\n  height: 28px;\n  display: inline-grid;\n  place-items: center;\n  border: 1px solid transparent;\n  border-radius: 7px;\n  color: var(--subtle);\n}\n\n.sidebar-task-delete:hover {\n  border-color: color-mix(in srgb, var(--danger) 28%, var(--border));\n  background: color-mix(in srgb, var(--danger) 9%, transparent);\n  color: var(--danger);\n}\n\n.sidebar-task-delete:disabled {\n  cursor: wait;\n  opacity: 0.7;\n}\n\n.sidebar-task-row:hover {\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n}\n\n.sidebar-task-row[aria-current=\"page\"] {\n  border-color: color-mix(in srgb, var(--accent) 22%, var(--border));\n  background: var(--accent-soft);\n}\n\n.sidebar-task-row:disabled {\n  cursor: not-allowed;\n  opacity: 0.72;\n}\n\n.sidebar-task-row:disabled:hover {\n  background: transparent;\n}\n\n.sidebar-task-copy {\n  min-width: 0;\n  display: grid;\n  gap: 1px;\n}\n\n.sidebar-task-copy strong,\n.sidebar-task-copy span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.sidebar-task-copy strong {\n  color: var(--text);\n  font-size: 13px;\n  font-weight: 680;\n}\n\n.sidebar-task-copy span {\n  color: var(--subtle);\n  font-size: 11px;\n  line-height: 14px;\n}\n\n.sidebar-task-icon {\n  color: color-mix(in srgb, var(--text) 62%, transparent);\n}\n\n.sidebar-task-row[data-status=\"draft\"] .sidebar-task-icon {\n  color: var(--accent);\n}\n\n.sidebar-task-row[data-status=\"waiting_approval\"] .sidebar-task-icon {\n  color: var(--warning);\n}\n\n.sidebar-task-row[data-status=\"failed\"] .sidebar-task-icon,\n.sidebar-task-row[data-status=\"repair_required\"] .sidebar-task-icon {\n  color: var(--danger);\n}\n\n.sidebar-task-row[data-status=\"paused\"] .sidebar-task-icon {\n  color: var(--subtle);\n}\n\n.sidebar-task-spinner {\n  color: var(--accent);\n  animation: conversation-run-spin 900ms linear infinite;\n}\n\n.sidebar-task-unread {\n  width: 7px;\n  height: 7px;\n  border-radius: 999px;\n  background: var(--warning);\n  box-shadow: 0 0 10px var(--warning-soft);\n}\n\n.sidebar-section h2 {\n  margin: 0;\n  padding: 0 16px;\n  color: var(--subtle);\n  font-size: 13px;\n  font-weight: 700;\n  line-height: 22px;\n}\n\n.sidebar-section-heading {\n  min-width: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 58px;\n  align-items: center;\n  gap: 2px;\n  padding-right: 0;\n}\n\n.sidebar-section-actions {\n  width: 58px;\n  display: grid;\n  grid-template-columns: repeat(2, 28px);\n  align-items: center;\n  gap: 2px;\n}\n\n.sidebar-section-action,\n.sidebar-project-menu-trigger {\n  width: 28px;\n  height: 28px;\n  flex: 0 0 auto;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid transparent;\n  border-radius: 7px;\n  color: var(--subtle);\n}\n\n.sidebar-section-action:hover,\n.sidebar-project-menu-trigger:hover,\n.sidebar-project-menu-trigger[aria-expanded=\"true\"] {\n  border-color: color-mix(in srgb, var(--text) 10%, transparent);\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n  color: var(--text);\n}\n\n.sidebar-project-tree {\n  min-height: 0;\n  align-content: start;\n  grid-auto-rows: max-content;\n  overflow-x: hidden;\n  overflow-y: auto;\n  margin-right: -12px;\n  padding: 0 12px 4px 0;\n}\n\n.sidebar-conversation-tree {\n  padding: 2px 0 7px;\n}\n\n.sidebar-conversation-row-shell {\n  min-width: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  align-items: center;\n}\n\n.sidebar-conversation-row-shell[data-has-action=\"true\"] {\n  grid-template-columns: minmax(0, 1fr) 28px;\n}\n\n.sidebar-conversation-archive {\n  width: 28px;\n  height: 28px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid transparent;\n  border-radius: 7px;\n  color: var(--subtle);\n  opacity: 0;\n  transition: opacity 120ms ease;\n}\n\n.sidebar-conversation-row-shell:hover .sidebar-conversation-archive,\n.sidebar-conversation-row-shell:focus-within .sidebar-conversation-archive,\n.nested-conversation-row[aria-current=\"page\"] + .sidebar-conversation-archive {\n  opacity: 1;\n}\n\n.sidebar-conversation-archive:hover:not(:disabled) {\n  border-color: color-mix(in srgb, var(--text) 10%, transparent);\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n  color: var(--text);\n}\n\n.sidebar-conversation-archive:disabled {\n  cursor: not-allowed;\n  color: color-mix(in srgb, var(--subtle) 58%, transparent);\n}\n\n@media (hover: none) {\n  .sidebar-conversation-archive {\n    opacity: 1;\n  }\n}\n\n.sidebar-project-row-shell {\n  position: relative;\n  min-width: 0;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 58px;\n  align-items: center;\n  gap: 2px;\n}\n\n.sidebar-project-actions {\n  position: relative;\n  width: 58px;\n  display: grid;\n  grid-template-columns: repeat(2, 28px);\n  align-items: center;\n  gap: 2px;\n  opacity: 0;\n  transition: opacity 120ms ease;\n}\n\n.sidebar-project-row-shell:hover .sidebar-project-actions,\n.sidebar-project-row-shell:focus-within .sidebar-project-actions {\n  opacity: 1;\n}\n\n.sidebar-project-new-conversation,\n.sidebar-project-menu-trigger {\n  width: 28px;\n  height: 28px;\n  flex: 0 0 auto;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid transparent;\n  border-radius: 7px;\n  color: var(--subtle);\n}\n\n.sidebar-project-new-conversation:hover {\n  border-color: color-mix(in srgb, var(--text) 10%, transparent);\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n  color: var(--text);\n}\n\n.sidebar-project-menu-shell {\n  position: relative;\n}\n\n.sidebar-project-menu {\n  position: absolute;\n  z-index: 20;\n  top: calc(100% + 4px);\n  right: 0;\n  width: 156px;\n  padding: 4px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--popover);\n  box-shadow: 0 14px 32px color-mix(in srgb, var(--shadow-base) 26%, transparent);\n}\n\n.sidebar-project-menu button {\n  width: 100%;\n  min-height: 34px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 0 9px;\n  border-radius: 6px;\n  color: var(--text);\n  text-align: left;\n}\n\n.sidebar-project-menu button:hover {\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n}\n\n.sidebar-row,\n.conversation-row {\n  width: 100%;\n  min-width: 0;\n  border: 1px solid transparent;\n  border-radius: 9px;\n  color: inherit;\n  text-align: left;\n}\n\n.sidebar-row {\n  height: 40px;\n  min-height: 40px;\n  display: grid;\n  grid-template-columns: 22px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 4px;\n  padding: 0 6px;\n  font-size: 14px;\n  font-weight: 680;\n}\n\n.project-row {\n  font-weight: 520;\n}\n\n.project-row[data-current-project=\"true\"] .project-icon {\n  color: var(--accent);\n  filter: drop-shadow(0 0 10px var(--accent-glow));\n}\n\n.sidebar-row:hover,\n.conversation-row:hover,\n.sidebar-account-button:hover,\n.sidebar-settings-button:hover {\n  background: color-mix(in srgb, var(--text) 7%, transparent);\n}\n\n.sidebar-row[aria-current=\"true\"],\n.sidebar-row[aria-current=\"page\"] {\n  border-color: color-mix(in srgb, var(--accent) 22%, var(--border));\n  background: var(--accent-soft);\n  box-shadow: 0 0 22px var(--accent-soft);\n}\n\n.sidebar-row svg {\n  color: color-mix(in srgb, var(--text) 72%, transparent);\n}\n\n.sidebar-row span,\n.conversation-row strong,\n.conversation-row span {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.conversation-row {\n  min-height: 32px;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 10px;\n  padding: 0 10px 0 32px;\n}\n\n.nested-conversation-row[aria-current=\"page\"] {\n  background: var(--accent-soft);\n}\n\n.conversation-row strong {\n  font-size: 13.5px;\n  font-weight: 700;\n}\n\n.conversation-row-meta {\n  display: inline-flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 6px;\n}\n\n.conversation-run-spinner {\n  flex: 0 0 auto;\n  color: var(--accent);\n  animation: conversation-run-spin 900ms linear infinite;\n}\n\n.conversation-row span,\n.sidebar-empty {\n  color: var(--subtle);\n  font-size: 12px;\n}\n\n@keyframes conversation-run-spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .conversation-run-spinner {\n    animation: none;\n  }\n\n  .process-summary-spinner {\n    animation: none;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .sidebar-task-spinner {\n    animation: none;\n  }\n}\n\n.sidebar-empty {\n  margin: 0;\n  padding: 4px 16px;\n  font-weight: 650;\n}\n\n.sidebar-bottom {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 36px;\n  align-items: center;\n  gap: 4px;\n  padding-top: 8px;\n  border-top: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n}\n\n.sidebar-account-button {\n  min-width: 0;\n  height: 42px;\n  display: grid;\n  grid-template-columns: 26px minmax(0, 1fr);\n  align-items: center;\n  gap: 7px;\n  padding: 0 6px;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  color: inherit;\n  text-align: left;\n}\n\n.sidebar-account-button[aria-current=\"page\"],\n.sidebar-settings-button[aria-current=\"page\"] {\n  border-color: color-mix(in srgb, var(--accent) 22%, var(--border));\n  background: var(--accent-soft);\n}\n\n.sidebar-account-avatar {\n  width: 26px;\n  height: 26px;\n  flex: 0 0 auto;\n  display: grid;\n  place-items: center;\n  border: 1px solid color-mix(in srgb, var(--text) 9%, transparent);\n  border-radius: 8px;\n  background: var(--surface-3);\n  color: var(--text);\n}\n\n.sidebar-account-copy {\n  min-width: 0;\n  display: grid;\n  gap: 1px;\n}\n\n.sidebar-account-copy strong,\n.sidebar-account-copy small {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.sidebar-account-copy strong {\n  font-size: 13px;\n  font-weight: 680;\n}\n\n.sidebar-account-copy small {\n  color: var(--subtle);\n  font-size: 10px;\n}\n\n.sidebar-settings-button {\n  width: 36px;\n  height: 36px;\n  display: grid;\n  place-items: center;\n  padding: 0;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  color: color-mix(in srgb, var(--text) 72%, transparent);\n}\n\n.clawee-sidebar-pane[data-collapsed=\"true\"] {\n  background: var(--sidebar);\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] {\n  grid-template-rows: auto auto minmax(0, 1fr) auto;\n  gap: 14px;\n  align-items: start;\n  padding: 20px 8px 12px;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-brand {\n  justify-content: center;\n  padding: 0;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-primary {\n  justify-items: center;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-row {\n  width: 44px;\n  height: 42px;\n  min-height: 42px;\n  grid-template-columns: 1fr;\n  justify-items: center;\n  gap: 0;\n  padding: 0;\n  border-radius: 12px;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-row > span {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-bottom {\n  grid-row: 4;\n  grid-template-columns: 1fr;\n  justify-items: center;\n  gap: 4px;\n  padding-top: 0;\n  border-top: 0;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-account-button,\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-settings-button {\n  width: 44px;\n  height: 42px;\n  display: grid;\n  place-items: center;\n  grid-template-columns: 1fr;\n  padding: 0;\n  border-radius: 12px;\n}\n\n.clawee-sidebar[data-collapsed=\"true\"] .sidebar-account-copy {\n  display: none;\n}\n\n.enterprise-account-page {\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  overflow: auto;\n  padding: 32px clamp(24px, 5vw, 64px) 56px;\n  background: var(--conversation-bg);\n  color: var(--text);\n}\n\n.enterprise-account-status,\n.enterprise-account-error,\n.enterprise-account-notice,\n.enterprise-account-panel {\n  width: min(720px, 100%);\n  margin-right: auto;\n  margin-left: auto;\n}\n\n.enterprise-account-status {\n  display: grid;\n  grid-template-columns: 22px minmax(0, 1fr);\n  align-items: start;\n  gap: 10px;\n  margin-top: 18px;\n  padding: 12px 14px;\n  border: 1px solid color-mix(in srgb, var(--warning) 35%, var(--border));\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--warning) 8%, var(--surface));\n  color: var(--warning);\n}\n\n.enterprise-account-status {\n  margin-top: 0;\n  border-color: var(--border);\n  background: var(--surface-2);\n  color: var(--muted);\n}\n\n.enterprise-account-status strong,\n.enterprise-account-status span {\n  display: block;\n}\n\n.enterprise-account-status strong {\n  color: var(--text);\n  font-size: 12px;\n}\n\n.enterprise-account-status span {\n  margin-top: 3px;\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.5;\n}\n\n.enterprise-account-error,\n.enterprise-account-notice {\n  margin-top: 16px;\n  margin-bottom: 0;\n  padding: 10px 12px;\n  border: 1px solid color-mix(in srgb, var(--danger) 32%, var(--border));\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--danger) 8%, var(--surface));\n  color: var(--danger);\n  font-size: 12px;\n}\n\n.enterprise-account-notice {\n  border-color: color-mix(in srgb, var(--success) 32%, var(--border));\n  background: color-mix(in srgb, var(--success) 7%, var(--surface));\n  color: var(--success);\n}\n\n.enterprise-account-panel {\n  margin-top: 22px;\n  padding: 24px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface);\n  box-shadow: 0 16px 38px color-mix(in srgb, var(--shadow-base) 18%, transparent);\n}\n\n.enterprise-account-session-panel,\n.enterprise-account-profile {\n  display: grid;\n  grid-template-columns: 36px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 16px;\n}\n\n.enterprise-account-session-panel h2,\n.enterprise-account-profile h2,\n.enterprise-account-form-heading h2 {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 710;\n}\n\n.enterprise-account-session-panel p,\n.enterprise-account-profile p,\n.enterprise-account-form-heading p {\n  margin: 5px 0 0;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.55;\n}\n\n.enterprise-account-session-panel p strong,\n.enterprise-account-session-panel p span {\n  margin-left: 6px;\n}\n\n.enterprise-account-spinner {\n  animation: conversation-run-spin 900ms linear infinite;\n}\n\n.enterprise-account-secondary-action,\n.enterprise-account-primary-action {\n  min-height: 36px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  padding: 0 13px;\n  border: 1px solid var(--border-strong);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--text);\n  font-size: 12px;\n  font-weight: 680;\n}\n\n.enterprise-account-secondary-action:hover:not(:disabled) {\n  border-color: color-mix(in srgb, var(--accent) 35%, var(--border-strong));\n  background: var(--surface-3);\n}\n\n.enterprise-account-secondary-action:disabled,\n.enterprise-account-primary-action:disabled {\n  cursor: not-allowed;\n  opacity: 0.58;\n}\n\n.enterprise-account-profile-icon,\n.enterprise-account-form-icon {\n  width: 36px;\n  height: 36px;\n  display: grid;\n  place-items: center;\n  border: 1px solid color-mix(in srgb, var(--success) 28%, var(--border));\n  border-radius: 8px;\n  background: color-mix(in srgb, var(--success) 8%, var(--surface-2));\n  color: var(--success);\n}\n\n.enterprise-account-profile-copy {\n  min-width: 0;\n}\n\n.enterprise-account-profile-copy > span {\n  color: var(--success);\n  font-size: 11px;\n  font-weight: 680;\n}\n\n.enterprise-account-profile-copy small {\n  display: block;\n  margin-top: 9px;\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n.enterprise-account-form-panel {\n  max-width: 520px;\n  margin-top: 0;\n}\n\n.enterprise-account-form-heading {\n  display: grid;\n  grid-template-columns: 36px minmax(0, 1fr);\n  align-items: center;\n  gap: 12px;\n}\n\n.enterprise-account-form-icon {\n  border-color: color-mix(in srgb, var(--accent) 28%, var(--border));\n  background: var(--accent-soft);\n  color: var(--accent);\n}\n\n.enterprise-account-segmented {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 3px;\n  margin-top: 22px;\n  padding: 3px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface-2);\n}\n\n.enterprise-account-segmented button {\n  min-height: 34px;\n  border-radius: 6px;\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 680;\n}\n\n.enterprise-account-segmented button[aria-pressed=\"true\"] {\n  background: var(--surface);\n  color: var(--text);\n  box-shadow: inset 0 0 0 1px var(--border-strong);\n}\n\n.enterprise-account-form {\n  display: grid;\n  gap: 14px;\n  margin-top: 20px;\n}\n\n.enterprise-account-form label {\n  display: grid;\n  gap: 7px;\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 650;\n}\n\n.enterprise-account-form input {\n  width: 100%;\n  height: 40px;\n  padding: 0 11px;\n  border: 1px solid var(--border-strong);\n  border-radius: 7px;\n  outline: 0;\n  background: var(--input-bg);\n  color: var(--text);\n}\n\n.enterprise-account-form input:focus {\n  border-color: color-mix(in srgb, var(--accent) 66%, var(--border-strong));\n  box-shadow: 0 0 0 3px var(--accent-soft);\n}\n\n.enterprise-account-primary-action {\n  margin-top: 4px;\n  border-color: var(--accent);\n  background: var(--accent);\n  color: var(--on-accent);\n}\n\n.enterprise-account-primary-action:hover:not(:disabled) {\n  filter: brightness(1.06);\n}\n\n@media (max-width: 720px) {\n  .enterprise-account-page {\n    padding: 24px 16px 40px;\n  }\n\n  .enterprise-account-session-panel,\n  .enterprise-account-profile {\n    grid-template-columns: 36px minmax(0, 1fr);\n  }\n\n  .enterprise-account-session-panel .enterprise-account-secondary-action,\n  .enterprise-account-profile .enterprise-account-secondary-action {\n    grid-column: 1 / -1;\n    width: 100%;\n  }\n}\n\n.detail-panel {\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr) auto;\n  border-left: 1px solid var(--border);\n  background: var(--surface);\n  color: var(--text);\n}\n\n.settings-page {\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  display: grid;\n  grid-template-columns: 240px minmax(0, 1fr);\n  background: var(--bg);\n  color: var(--text);\n}\n\n.settings-sidebar {\n  min-width: 0;\n  min-height: 0;\n  display: grid;\n  grid-template-rows: auto auto auto minmax(0, 1fr);\n  gap: 14px;\n  padding: 14px 12px;\n  border-right: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n  background: var(--sidebar);\n}\n\n.settings-back {\n  min-height: 32px;\n  justify-self: start;\n  padding: 0 10px;\n  border-radius: 7px;\n  background: color-mix(in srgb, var(--text) 6%, transparent);\n  color: var(--text);\n  font-size: 13px;\n  font-weight: 650;\n}\n\n.settings-back:hover,\n.settings-nav button:hover,\n.settings-action:hover {\n  background: color-mix(in srgb, var(--text) 10%, transparent);\n}\n\n.settings-search {\n  min-width: 0;\n  display: grid;\n  gap: 6px;\n}\n\n.settings-search span {\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 650;\n}\n\n.settings-search input {\n  width: 100%;\n  min-width: 0;\n  height: 34px;\n  padding: 0 10px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface-2);\n  color: var(--text);\n  font-size: 13px;\n}\n\n.settings-nav {\n  min-width: 0;\n  display: grid;\n  align-content: start;\n  gap: 4px;\n}\n\n.settings-nav button {\n  width: 100%;\n  min-height: 34px;\n  padding: 0 10px;\n  border-radius: 7px;\n  color: var(--text);\n  text-align: left;\n  font-size: 13px;\n  font-weight: 650;\n}\n\n.settings-nav button[aria-current=\"page\"] {\n  background: var(--accent-soft);\n  box-shadow: inset 2px 0 0 var(--accent);\n}\n\n.settings-content {\n  min-width: 0;\n  min-height: 0;\n  overflow: auto;\n  padding: 48px clamp(24px, 6vw, 72px);\n}\n\n.settings-section {\n  width: min(720px, 100%);\n  display: grid;\n  gap: 18px;\n}\n\n.settings-section header {\n  display: grid;\n  gap: 6px;\n}\n\n.settings-section h1,\n.settings-section h2,\n.settings-section p {\n  margin: 0;\n}\n\n.settings-section h1 {\n  font-size: 26px;\n  line-height: 1.2;\n}\n\n.settings-section h2 {\n  padding: 4px 14px 0;\n  font-size: 13px;\n  line-height: 1.4;\n}\n\n.settings-section p {\n  color: var(--muted);\n  font-size: 13px;\n  line-height: 1.5;\n}\n\n.settings-card {\n  min-width: 0;\n  display: grid;\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  background: var(--surface);\n  box-shadow: var(--shadow);\n}\n\n.settings-row {\n  min-width: 0;\n  min-height: 48px;\n  display: grid;\n  grid-template-columns: minmax(160px, 0.8fr) minmax(0, 1.2fr);\n  align-items: center;\n  gap: 16px;\n  padding: 10px 14px;\n  border-top: 1px solid var(--border);\n}\n\n.settings-row:first-child {\n  border-top: 0;\n}\n\n.settings-row span {\n  color: var(--muted);\n  font-size: 13px;\n  font-weight: 650;\n}\n\n.settings-row strong {\n  min-width: 0;\n  color: var(--text);\n  font-size: 13px;\n  font-weight: 520;\n  overflow-wrap: anywhere;\n  text-align: right;\n}\n\n.settings-control-row {\n  grid-template-columns: minmax(160px, 1fr) auto;\n}\n\n.settings-select {\n  width: min(240px, 100%);\n  min-width: 180px;\n  height: 34px;\n  justify-self: end;\n  padding: 0 34px 0 10px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--text);\n}\n\n.settings-color-mode {\n  justify-self: end;\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n  padding: 3px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n}\n\n.settings-color-mode button {\n  min-width: 68px;\n  height: 28px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  padding: 0 9px;\n  border-radius: 5px;\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 650;\n  white-space: nowrap;\n}\n\n.settings-color-mode button:hover {\n  color: var(--text);\n}\n\n.settings-color-mode button[aria-pressed=\"true\"] {\n  background: var(--text);\n  color: var(--bg);\n  box-shadow: none;\n}\n\n.settings-accent-color {\n  display: flex;\n  align-items: start;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 8px;\n}\n\n.settings-accent-controls {\n  justify-self: end;\n  min-width: 0;\n}\n\n.settings-accent-options {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 4px;\n}\n\n.settings-accent-options > button {\n  width: 30px;\n  height: 30px;\n  display: inline-grid;\n  place-items: center;\n  padding: 0;\n  border: 1px solid transparent;\n  border-radius: 7px;\n  color: rgba(255, 255, 255, 0.94);\n}\n\n.settings-accent-options > button:hover {\n  background: color-mix(in srgb, var(--settings-accent-swatch) 9%, transparent);\n}\n\n.settings-accent-options > button[aria-checked=\"true\"] {\n  border-color: color-mix(in srgb, var(--settings-accent-swatch) 62%, var(--border));\n  background: color-mix(in srgb, var(--settings-accent-swatch) 13%, transparent);\n}\n\n.settings-custom-accent-option {\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n}\n\n.settings-row .settings-accent-separator {\n  color: var(--subtle);\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 30px;\n}\n\n.settings-custom-accent-option > .settings-custom-accent-choice {\n  width: auto;\n  display: inline-flex;\n  flex-direction: row;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 6px;\n  padding: 0 2px;\n  border-color: transparent;\n  background: transparent;\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 600;\n  white-space: nowrap;\n}\n\n.settings-custom-accent-option > .settings-custom-accent-choice:hover,\n.settings-custom-accent-option > .settings-custom-accent-choice[aria-checked=\"true\"] {\n  border-color: transparent;\n  background: transparent;\n  color: var(--text);\n}\n\n.settings-accent-swatch {\n  width: 18px;\n  height: 18px;\n  display: grid;\n  place-items: center;\n  border-radius: 999px;\n  background: var(--settings-accent-swatch);\n  color: inherit !important;\n}\n\n.settings-custom-accent-choice .settings-accent-swatch {\n  color: var(--custom-on-accent) !important;\n}\n\n.settings-custom-accent {\n  position: relative;\n  width: 128px;\n  display: grid;\n  gap: 3px;\n}\n\n.settings-custom-accent-input-label {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n.settings-custom-accent input {\n  width: 100%;\n  height: 30px;\n  padding: 0 9px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  outline: none;\n  background: var(--surface-2);\n  color: var(--text);\n  box-shadow: none;\n  font-family: var(--font-mono);\n  font-size: 12px;\n}\n\n.settings-custom-accent input:focus-visible {\n  border-color: var(--border-strong);\n  outline: none;\n  box-shadow: none;\n}\n\n.settings-custom-accent input[aria-invalid=\"true\"] {\n  border-color: color-mix(in srgb, var(--danger) 58%, var(--border));\n}\n\n.settings-custom-accent .settings-custom-accent-error {\n  margin: 0;\n  color: var(--danger);\n  font-size: 11px;\n  line-height: 1.35;\n}\n\n.settings-action {\n  justify-self: end;\n  min-height: 30px;\n  padding: 0 10px;\n  border-radius: 7px;\n  background: color-mix(in srgb, var(--text) 6%, transparent);\n  color: var(--text);\n  font-size: 13px;\n  font-weight: 650;\n}\n\n.settings-advanced {\n  gap: 0;\n}\n\n@media (max-width: 720px) {\n  .settings-page {\n    height: 100%;\n    min-height: 0;\n    grid-template-columns: 1fr;\n    grid-template-rows: auto minmax(0, 1fr);\n  }\n\n  .settings-sidebar {\n    grid-template-rows: auto auto auto;\n    border-right: 0;\n    border-bottom: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n  }\n\n  .settings-nav {\n    display: flex;\n    gap: 4px;\n    padding-bottom: 2px;\n    overflow-x: auto;\n    overscroll-behavior-x: contain;\n  }\n\n  .settings-nav button {\n    width: auto;\n    flex: 0 0 auto;\n    white-space: nowrap;\n  }\n\n  .settings-content {\n    min-height: 0;\n    overflow: auto;\n    padding: 24px 16px;\n  }\n\n  .settings-row {\n    grid-template-columns: 1fr;\n    gap: 4px;\n  }\n\n  .settings-row strong {\n    text-align: left;\n  }\n\n  .settings-select {\n    width: 100%;\n    min-width: 0;\n    justify-self: stretch;\n  }\n\n  .settings-accent-controls {\n    justify-self: stretch;\n  }\n\n  .settings-accent-color {\n    justify-content: flex-start;\n  }\n\n  .settings-custom-accent {\n    width: min(196px, 100%);\n  }\n\n  .settings-action {\n    justify-self: start;\n  }\n}\n\n.detail-header {\n  min-width: 0;\n  min-height: 56px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 10px 14px;\n  border-bottom: 1px solid var(--border);\n  background: var(--surface);\n}\n\n.detail-title {\n  min-width: 0;\n  display: grid;\n  gap: 2px;\n}\n\n.detail-title h2 {\n  margin: 0;\n  overflow: hidden;\n  color: var(--text);\n  font-size: 14px;\n  font-weight: 720;\n  line-height: 1.25;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.detail-title span {\n  min-width: 0;\n  overflow: hidden;\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.3;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.detail-content {\n  min-width: 0;\n  min-height: 0;\n  overflow: auto;\n  padding: 14px;\n  background: var(--surface-2);\n}\n\n.detail-content pre {\n  min-height: 100%;\n  margin: 0;\n  padding: 12px;\n  overflow: auto;\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  background: var(--surface);\n  color: var(--text);\n  font: 12px/1.55 var(--font-mono);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.detail-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 12px 14px;\n  border-top: 1px solid var(--border);\n  background: var(--surface);\n}\n\n@media (max-height: 560px) and (min-width: 921px) {\n  .composer-wrap {\n    padding: 0 clamp(18px, 4vw, 52px) 10px;\n  }\n}\n\n.toolbar-button.primary {\n  border-color: color-mix(in srgb, var(--accent) 72%, var(--border));\n  background: linear-gradient(180deg, var(--accent-strong), var(--accent));\n  color: var(--on-accent);\n  box-shadow: 0 10px 24px var(--accent-glow);\n}\n\n.toolbar-button.primary:hover {\n  background: var(--accent-strong);\n}\n\n.toolbar-button:disabled,\n.icon-button:disabled,\n.toolbar-button.primary:disabled {\n  border-color: var(--border);\n  background: var(--surface-3);\n  color: var(--subtle);\n}\n\n@media (max-width: 920px) {\n  .clawee-shell,\n  .clawee-shell.has-detail {\n    width: 100%;\n    height: 100dvh;\n    min-height: 0;\n    grid-template-columns: 1fr;\n    grid-template-rows: minmax(0, 1fr);\n    overflow: hidden;\n  }\n\n  .clawee-main-pane {\n    height: 100dvh;\n    grid-template-rows: auto minmax(0, 1fr);\n    overflow: hidden;\n  }\n\n  .clawee-sidebar-pane {\n    position: fixed;\n    inset: 0 auto 0 0;\n    z-index: 72;\n    width: min(320px, calc(100vw - 48px));\n    border-right: 1px solid color-mix(in srgb, var(--text) 10%, transparent);\n    border-bottom: 0;\n    box-shadow: 18px 0 44px color-mix(in srgb, var(--shadow-base) 38%, transparent);\n    transform: translateX(-100%);\n    visibility: hidden;\n    transition:\n      transform 180ms ease,\n      visibility 180ms ease;\n  }\n\n  .clawee-sidebar-pane[data-mobile-open=\"true\"] {\n    transform: translateX(0);\n    visibility: visible;\n  }\n\n  .clawee-sidebar {\n    height: 100%;\n    padding-top: 18px;\n  }\n\n  .sidebar-collapse-button {\n    display: none;\n  }\n\n  .mobile-navigation-toolbar {\n    min-width: 0;\n    min-height: 50px;\n    display: flex;\n    align-items: center;\n    padding: 6px 10px;\n    border-bottom: 1px solid color-mix(in srgb, var(--text) 8%, transparent);\n    background: var(--conversation-bg);\n  }\n\n  .mobile-navigation-trigger,\n  .mobile-navigation-close {\n    width: 38px;\n    height: 38px;\n    place-items: center;\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    background: var(--surface-2);\n    color: var(--text);\n  }\n\n  .mobile-navigation-trigger {\n    display: inline-grid;\n  }\n\n  .mobile-navigation-close {\n    position: absolute;\n    top: 18px;\n    right: 12px;\n    z-index: 1;\n    display: grid;\n  }\n\n  .mobile-navigation-backdrop {\n    position: fixed;\n    inset: 0;\n    z-index: 71;\n    display: block;\n    width: 100%;\n    height: 100%;\n    padding: 0;\n    border: 0;\n    border-radius: 0;\n    background: color-mix(in srgb, var(--shadow-base) 66%, transparent);\n  }\n\n  .clawee-main-content {\n    min-height: 0;\n    overflow: auto;\n    overscroll-behavior: contain;\n  }\n\n  .sidebar-bottom {\n    padding-top: 4px;\n  }\n\n  .clawee-detail-pane {\n    display: none;\n  }\n\n  .conversation-file-layout {\n    grid-template-columns: 1fr;\n    grid-template-rows: minmax(520px, 1fr) minmax(520px, 1fr);\n  }\n\n  .conversation-file-layout > .conversation-page {\n    border-right: 0;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .conversation-file-resize-handle {\n    display: none;\n  }\n\n  .conversation-header {\n    align-items: flex-start;\n    flex-wrap: wrap;\n  }\n\n  .conversation-title-row {\n    flex-wrap: wrap;\n  }\n\n  .conversation-actions {\n    flex-wrap: wrap;\n    justify-content: flex-end;\n  }\n\n  .file-top-bar-control-row,\n  .file-path-bar {\n    align-items: flex-start;\n    flex-wrap: wrap;\n  }\n\n  .file-workspace-body {\n    grid-template-columns: minmax(0, 1fr) 6px minmax(200px, 240px);\n  }\n\n  .file-workspace-body[data-tree-collapsed=\"true\"] {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .conversation-empty-state {\n    gap: 16px;\n    padding: 24px 16px;\n  }\n\n  .conversation-empty-state h2 {\n    max-width: 16rem;\n    font-size: 38px;\n    overflow-wrap: anywhere;\n  }\n\n  .composer-wrap {\n    padding: 0 12px 6px;\n  }\n\n  .clawee-composer {\n    border-radius: 10px;\n  }\n\n  .composer-queue {\n    max-height: 116px;\n    margin-right: 6px;\n    margin-left: 6px;\n    padding-right: 7px;\n    padding-left: 7px;\n    border-radius: 9px 9px 0 0;\n  }\n\n  .composer-toolbar,\n  .composer-left-actions,\n  .composer-right-actions {\n    flex-wrap: wrap;\n  }\n\n  .composer-toolbar {\n    gap: 8px;\n    align-items: flex-start;\n  }\n\n  .composer-left-actions {\n    flex: 1 1 100%;\n  }\n\n  .composer-right-actions {\n    flex: 1 1 100%;\n    justify-content: space-between;\n  }\n\n  .composer-submit-menu {\n    right: 0;\n    left: auto;\n  }\n\n  .composer-select,\n  .composer-model-button {\n    max-width: calc(100vw - 96px);\n  }\n\n  .timeline-queue-state {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 8px;\n  }\n}\n\n@media (max-width: 480px) {\n  html,\n  body,\n  #root {\n    overflow-x: hidden;\n  }\n\n  .clawee-shell,\n  .clawee-shell.has-detail {\n    height: 100dvh;\n    grid-template-rows: minmax(0, 1fr);\n  }\n\n  .clawee-sidebar {\n    max-width: 100%;\n    padding: 10px;\n    overflow: hidden;\n  }\n\n  .sidebar-primary {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .sidebar-project-tree,\n  .sidebar-conversation-tree {\n    max-width: 100%;\n    overflow: hidden;\n  }\n\n  .sidebar-section h2 {\n    padding-inline: 4px;\n  }\n\n  .sidebar-bottom {\n    grid-template-columns: 1fr auto;\n  }\n\n  .conversation-header {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    padding: 10px 12px;\n  }\n\n  .schedule-thread-header {\n    align-items: flex-start;\n  }\n\n  .schedule-thread-main {\n    flex: 1 1 100%;\n  }\n\n  .schedule-thread-actions {\n    margin-left: auto;\n  }\n\n  .schedule-thread-editor-backdrop {\n    padding: 0;\n  }\n\n  .schedule-thread-editor-dialog {\n    width: 100%;\n    height: 100dvh;\n    border: 0;\n    border-radius: 0;\n  }\n\n  .schedule-thread-editor-dialog .schedule-editor,\n  .schedule-thread-editor-loading {\n    padding: 0 12px;\n  }\n\n  .conversation-actions .toolbar-button span {\n    display: none;\n  }\n\n  .file-top-bar,\n  .file-path-bar {\n    padding: 10px 12px;\n  }\n\n  .file-workspace-body {\n    grid-template-columns: 1fr;\n    grid-template-rows: minmax(0, 1fr) minmax(180px, 240px);\n  }\n\n  .file-tree-resize-handle {\n    display: none;\n  }\n\n  .file-workspace-editor {\n    border-right: 0;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .conversation-empty-state h2 {\n    font-size: 30px;\n  }\n\n  .attachment-image-preview-backdrop {\n    padding: 12px;\n  }\n\n  .attachment-image-preview {\n    width: calc(100vw - 32px);\n    height: calc(100dvh - 96px);\n  }\n\n  .attachment-image-preview > button {\n    top: 10px;\n    right: 10px;\n  }\n}\n\n.markdown-prose {\n  min-width: 0;\n  color: var(--text);\n  font-size: 14px;\n  line-height: 1.68;\n  overflow-wrap: anywhere;\n}\n\n.markdown-prose[data-variant=\"assistant\"],\n.markdown-prose[data-variant=\"document\"] {\n  font-size: 15px;\n  line-height: 1.76;\n}\n\n.markdown-prose[data-variant=\"process\"],\n.markdown-prose[data-variant=\"tool\"],\n.markdown-prose[data-variant=\"diagnostic\"] {\n  color: var(--muted);\n  font-size: 12.5px;\n  line-height: 1.58;\n}\n\n.markdown-prose .md-p {\n  margin: 0;\n}\n\n.markdown-prose .md-p + .md-p,\n.markdown-prose .md-p + .md-code-block,\n.markdown-prose .md-code-block + .md-p,\n.markdown-prose .md-p + .md-table-wrap,\n.markdown-prose .md-table-wrap + .md-p {\n  margin-top: 12px;\n}\n\n.markdown-prose .md-h {\n  margin: 22px 0 9px;\n  color: var(--text);\n  font-weight: 700;\n  line-height: 1.3;\n}\n\n.markdown-prose .md-h:first-child {\n  margin-top: 0;\n}\n\n.markdown-prose .md-h1 {\n  font-size: 22px;\n}\n\n.markdown-prose .md-h2 {\n  font-size: 18px;\n}\n\n.markdown-prose .md-h3 {\n  font-size: 15px;\n}\n\n.markdown-prose .md-h4 {\n  font-size: 14px;\n}\n\n.markdown-prose .md-ul,\n.markdown-prose .md-ol {\n  margin: 12px 0;\n  padding-left: 24px;\n}\n\n.markdown-prose .md-ul li,\n.markdown-prose .md-ol li {\n  margin: 5px 0;\n}\n\n.markdown-prose .md-task-list {\n  padding-left: 0;\n  list-style: none;\n}\n\n.markdown-prose .md-task-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n}\n\n.markdown-prose .md-task-check {\n  width: 15px;\n  height: 15px;\n  margin-top: 3px;\n  flex: 0 0 auto;\n}\n\n.markdown-prose .md-quote {\n  margin: 12px 0;\n  padding-left: 12px;\n  border-left: 3px solid var(--border-strong);\n  color: var(--muted);\n}\n\n.markdown-prose .md-inline-code {\n  padding: 1px 4px;\n  border-radius: 5px;\n  background: var(--surface-3);\n  color: var(--text);\n  font-family: var(--font-mono);\n  font-size: 0.9em;\n}\n\n.markdown-prose .md-skill-reference {\n  display: inline-flex;\n  align-items: center;\n  min-height: 22px;\n  padding: 1px 6px;\n  border: 1px solid color-mix(in srgb, var(--accent) 34%, var(--border));\n  border-radius: 5px;\n  background: color-mix(in srgb, var(--accent) 9%, var(--surface));\n  color: var(--accent);\n  font-family: var(--font-mono);\n  font-size: 0.9em;\n  font-weight: 650;\n}\n\n.markdown-prose .md-code-block,\n.detail-code-block,\n.process-code-payload {\n  margin: 12px 0;\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  background: var(--surface-2);\n}\n\n.markdown-prose .md-code-header {\n  min-height: 34px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 6px 10px 6px 12px;\n  border-bottom: 1px solid var(--border);\n}\n\n.markdown-prose .md-code-lang {\n  color: var(--muted);\n  font: 600 11px/1 var(--font-mono);\n  text-transform: lowercase;\n}\n\n.markdown-prose .md-code-actions {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.markdown-prose .md-code-action {\n  min-height: 26px;\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 0 7px;\n  border-radius: 6px;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.markdown-prose .md-code-action:hover {\n  background: var(--surface-3);\n  color: var(--text);\n}\n\n.timeline-item .markdown-prose .md-code,\n.detail-content .markdown-prose .md-code,\n.detail-content .detail-code-block,\n.process-code-payload,\n.markdown-prose .md-code {\n  max-height: none;\n  margin: 0;\n  padding: 12px 14px;\n  overflow: auto;\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  color: var(--text);\n  font: 12.5px/1.62 var(--font-mono);\n  white-space: pre;\n  overflow-wrap: normal;\n}\n\n.detail-content .detail-code-block,\n.process-code-payload {\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  background: var(--surface);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.markdown-prose .md-link {\n  color: var(--accent);\n  text-decoration: none;\n  border-bottom: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);\n}\n\n.markdown-prose .md-link:hover {\n  border-bottom-color: var(--accent);\n}\n\n.markdown-prose .md-hr {\n  margin: 16px 0;\n  border: 0;\n  border-top: 1px solid var(--border);\n}\n\n.md-table-wrap {\n  max-width: 100%;\n  margin: 12px 0;\n  overflow-x: auto;\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  background: var(--surface);\n}\n\n.md-table {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 12.5px;\n}\n\n.md-table th,\n.md-table td {\n  padding: 8px 10px;\n  border-bottom: 1px solid var(--border);\n  text-align: left;\n  vertical-align: top;\n}\n\n.md-table th {\n  background: var(--surface-2);\n  font-weight: 700;\n}\n\n.md-table tr:last-child td {\n  border-bottom: 0;\n}\n\n.conversation-summary-status {\n  max-width: 220px;\n  color: var(--muted);\n  font-size: 11px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.conversation-summary-backdrop {\n  position: fixed;\n  z-index: 100;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: color-mix(in srgb, var(--shadow-base) 48%, transparent);\n}\n\n.conversation-summary-dialog {\n  width: min(640px, 100%);\n  max-height: min(720px, calc(100vh - 48px));\n  display: grid;\n  grid-template-rows: auto auto minmax(120px, 1fr) auto;\n  gap: 14px;\n  padding: 18px;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface);\n  box-shadow: 0 28px 80px color-mix(in srgb, var(--shadow-base) 38%, transparent);\n  overflow: hidden;\n}\n\n.conversation-summary-dialog > header,\n.conversation-summary-dialog > footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.project-management-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 120;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  background: rgb(0 0 0 / 48%);\n}\n\n.project-management-dialog {\n  width: min(760px, 100%);\n  max-height: min(820px, calc(100vh - 48px));\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: var(--surface-2);\n  box-shadow: 0 20px 64px rgb(0 0 0 / 32%);\n}\n\n.project-management-dialog > header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 20px;\n  padding: 20px 22px;\n  border-bottom: 1px solid var(--border);\n}\n\n.project-management-dialog h2,\n.project-management-dialog h3,\n.project-management-dialog p {\n  margin: 0;\n}\n\n.project-management-dialog > header p {\n  margin-top: 5px;\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.project-management-body {\n  display: grid;\n  gap: 24px;\n  max-height: calc(100vh - 170px);\n  overflow: auto;\n  padding: 20px 22px 24px;\n}\n\n.project-management-body > section {\n  display: grid;\n  gap: 10px;\n}\n\n.project-management-list {\n  display: grid;\n  gap: 8px;\n}\n\n.project-management-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  min-width: 0;\n  padding: 12px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n}\n\n.project-management-item-copy {\n  display: grid;\n  min-width: 0;\n  gap: 3px;\n}\n\n.project-management-item-copy span {\n  overflow-wrap: anywhere;\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.project-directory-warning {\n  color: var(--warning) !important;\n}\n\n.project-management-actions,\n.project-assignment-controls,\n.project-edit-actions {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.project-management-actions button,\n.project-management-item > button,\n.project-assignment-controls button,\n.project-edit-actions button {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.project-management-empty {\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.project-management-empty-action {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 12px;\n  border: 1px dashed var(--border);\n  border-radius: 6px;\n}\n\n.project-management-empty-action button {\n  min-height: 34px;\n  flex: 0 0 auto;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.project-edit-form {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n  padding: 14px;\n  border: 1px solid var(--border);\n  border-radius: 6px;\n  background: var(--surface-3);\n}\n\n.project-edit-form h3,\n.project-edit-actions {\n  grid-column: 1 / -1;\n}\n\n.project-edit-form label {\n  display: grid;\n  gap: 5px;\n  font-size: 12px;\n}\n\n.project-edit-form input,\n.project-edit-form select,\n.project-assignment-controls select {\n  min-width: 0;\n  height: 34px;\n  border: 1px solid var(--border);\n  border-radius: 5px;\n  padding: 0 9px;\n  color: var(--text);\n  background: var(--surface-2);\n}\n\n@media (max-width: 720px) {\n  .project-management-backdrop {\n    padding: 0;\n  }\n\n  .project-management-dialog {\n    width: 100%;\n    max-height: 100vh;\n    border-radius: 0;\n  }\n\n  .project-management-item {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .project-management-actions,\n  .project-assignment-controls {\n    flex-wrap: wrap;\n  }\n\n  .project-edit-form {\n    grid-template-columns: 1fr;\n  }\n\n  .project-edit-form h3,\n  .project-edit-actions {\n    grid-column: auto;\n  }\n}\n\n.conversation-summary-dialog > header span {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.conversation-summary-dialog h2 {\n  margin: 2px 0 0;\n  font-size: 18px;\n  letter-spacing: 0;\n}\n\n.conversation-summary-guide {\n  margin: 0;\n  color: var(--muted);\n  font-size: 12px;\n}\n\n.conversation-summary-content {\n  min-height: 0;\n  padding: 14px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  overflow: auto;\n}\n\n.conversation-summary-content p {\n  margin: 0;\n  color: var(--text);\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.conversation-summary-dialog > footer {\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n.memory-suggestion {\n  position: relative;\n  z-index: 2;\n  width: min(980px, 100%);\n  display: grid;\n  gap: 8px;\n  margin: 0 auto 10px;\n  padding: 11px 12px;\n  border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--border));\n  border-radius: 10px;\n  background: color-mix(in srgb, var(--surface) 96%, transparent);\n  box-shadow: 0 16px 42px color-mix(in srgb, var(--shadow-base) 28%, transparent);\n}\n\n.memory-suggestion__title {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  font-size: 13px;\n}\n\n.memory-suggestion__title svg {\n  color: var(--accent);\n}\n\n.memory-suggestion textarea {\n  width: 100%;\n  min-height: 58px;\n  resize: vertical;\n  padding: 8px 9px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--text);\n  font: inherit;\n  line-height: 1.45;\n}\n\n.memory-suggestion__actions {\n  display: flex;\n  align-items: end;\n  justify-content: flex-end;\n  flex-wrap: wrap;\n  gap: 7px;\n}\n\n.memory-suggestion__actions label {\n  min-width: 150px;\n  display: grid;\n  gap: 4px;\n  margin-right: auto;\n  color: var(--muted);\n  font-size: 11px;\n}\n\n.memory-suggestion__actions select {\n  height: 32px;\n  padding: 0 8px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--text);\n}\n\n.memory-suggestion__actions button,\n.memory-suggestion__warning button {\n  min-height: 32px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  padding: 0 10px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n  color: var(--text);\n}\n\n.memory-suggestion__actions .memory-suggestion__save {\n  border-color: var(--border-strong);\n  background: var(--accent);\n  color: var(--on-accent);\n}\n\n.memory-suggestion__warning {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 9px;\n  border: 1px solid color-mix(in srgb, var(--warning) 34%, var(--border));\n  border-radius: 7px;\n  color: var(--warning);\n  font-size: 12px;\n}\n\n.memory-suggestion__warning span {\n  min-width: 0;\n  flex: 1;\n}\n\n.run-context__item {\n  display: grid !important;\n  gap: 6px !important;\n  padding: 9px 10px;\n  border: 1px solid var(--border);\n  border-radius: 7px;\n  background: var(--surface-2);\n}\n\n.run-context__item > div {\n  min-width: 0;\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 7px;\n}\n\n.run-context__item code {\n  color: var(--muted);\n  font-size: 10px;\n  overflow-wrap: anywhere;\n}\n\n.run-context__item p {\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n@media (max-width: 720px) {\n  .conversation-summary-status {\n    display: none;\n  }\n\n  .memory-suggestion__actions {\n    align-items: stretch;\n  }\n\n  .memory-suggestion__actions label {\n    width: 100%;\