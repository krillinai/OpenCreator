{
  "name": "@opencreator/daemon",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @opencreator/protocol build && pnpm --filter @opencreator/skill-market build && node --import tsx scripts/prepare-enterprise-development-config-2026-08-09.ts",
    "dev": "node --import tsx src/main.ts --opencreator-enterprise-config=.runtime/config.toml",
    "prebuild": "pnpm --filter @opencreator/protocol build && pnpm --filter @opencreator/skill-market build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @opencreator/protocol build && pnpm --filter @opencreator/skill-market build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pretest": "pnpm --filter @opencreator/protocol build && pnpm --filter @opencreator/skill-market build",
    "test": "vitest run --passWithNoTests",
    "verify:schedule-upgrade": "node --import tsx scripts/verify-scheduled-task-upgrade.ts"
  },
  "dependencies": {
    "@opencreator/protocol": "workspace:*",
    "@opencreator/skill-market": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@iarna/toml": "2.2.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@napi-rs/keyring": "1.3.0",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^5.6.1",
    "cross-spawn": "^7.0.6",
    "fastify": "^5.2.1",
    "https-proxy-agent": "^7.0.6",
    "nanoid": "^5.0.9",
    "toml": "^3.0.0",
    "yaml": "^2.8.1",
    "yauzl": "3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cross-spawn": "^6.0.6",
    "@types/yauzl": "3.4.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring-darwin-arm64": "1.3.0",
    "@napi-rs/keyring-darwin-x64": "1.3.0",
    "@napi-rs/keyring-freebsd-x64": "1.3.0",
    "@napi-rs/keyring-linux-arm-gnueabihf": "1.3.0",
    "@napi-rs/keyring-linux-arm64-gnu": "1.3.0",
    "@napi-rs/keyring-linux-arm64-musl": "1.3.0",
    "@napi-rs/keyring-linux-riscv64-gnu": "1.3.0",
    "@napi-rs/keyring-linux-x64-gnu": "1.3.0",
    "@napi-rs/keyring-linux-x64-musl": "1.3.0",
    "@napi-rs/keyring-win32-arm64-msvc": "1.3.0",
    "@napi-rs/keyring-win32-ia32-msvc": "1.3.0",
    "@napi-rs/keyring-win32-x64-msvc": "1.3.0"
  }
}
