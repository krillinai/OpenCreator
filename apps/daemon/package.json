{
  "name": "@clawee/daemon",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @clawee/skill-market build",
    "dev": "tsx src/main.ts",
    "prebuild": "pnpm --filter @clawee/skill-market build",
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @clawee/skill-market build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pretest": "pnpm --filter @clawee/skill-market build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clawee/protocol": "workspace:*",
    "@clawee/skill-market": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "better-sqlite3": "^11.8.1",
    "cron-parser": "^5.6.1",
    "fastify": "^5.2.1",
    "nanoid": "^5.0.9",
    "tar": "^7.4.3",
    "toml": "^3.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12"
  }
}
