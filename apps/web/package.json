{
  "name": "@opencreator/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @opencreator/desktop prepare:creator-runtime && pnpm --filter @opencreator/protocol build && pnpm --filter @opencreator/skill-market build",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "pnpm --filter @opencreator/protocol build && pnpm --filter @opencreator/skill-market build",
    "build": "tsc -p tsconfig.json && vite build",
    "pretypecheck": "pnpm --filter @opencreator/protocol build && pnpm --filter @opencreator/skill-market build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @opencreator/protocol build && pnpm --filter @opencreator/skill-market build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@opencreator/protocol": "workspace:*",
    "@opencreator/skill-market": "workspace:*",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "react-virtuoso": "4.18.10",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^15.0.7",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "vitest": "^3.2.4"
  }
}
